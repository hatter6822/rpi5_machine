#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Build the firmware 'make check-firmware' boots on raspi5b, pinned: TF-A
# and U-Boot from their release tags and commits, with the
# aarch64-linux-gnu- cross compiler (CROSS_COMPILE overrides the prefix),
# and downloads checked against their SHA-256: the community EDK2 port for
# the Pi 5, and a Raspberry Pi OS kernel and device tree from a release of
# the Raspberry Pi firmware repository. From the same release come the
# overlays, which the rpi5-boot tests apply with dtmerge ('make build'
# builds it from the rpi-utils submodule).
#
#   scripts/firmware DIR
#
# DIR receives
#   bl31.bin                    TF-A's rpi5 BL31
#   u-boot.bin                  U-Boot's rpi_arm64_defconfig
#   RPI_EFI.fd                  EDK2: its own TF-A and UEFI in one armstub
#   edk2/bcm2712-rpi-5-b.dtb    the device tree the EDK2 release ships
#   kernel_2712.img             the Raspberry Pi OS kernel for the Pi 5
#   bcm2712-rpi-5-b.dtb         and its device tree
#   overlays/                   and the overlays, with their map and README
#   modules/                    the kernel's igb and i2c-algo-bit modules
# An output is made again only when its pin changes (DIR/.pins records
# what each was made from). DIR must be new, empty, or made by an earlier
# run, which leaves the marker .check-firmware; 'make distclean' requires
# it too before removing DIR.

set -euo pipefail

TFA_URL=https://github.com/ARM-software/arm-trusted-firmware.git
TFA_TAG=v2.15.0
TFA_COMMIT=da738d5eae93af342fdc4995dd3c05acb4c9d757

UBOOT_URL=https://github.com/u-boot/u-boot.git
UBOOT_TAG=v2026.07
UBOOT_COMMIT=ece349ade2973e220f524ce59e59711cc919263f

EDK2_URL=https://github.com/worproject/rpi5-uefi/releases/download/v0.3/RPi5_UEFI_Release_v0.3.zip
EDK2_SHA256=2337df318845448ebcc8a6a587d15dccec44b54c665ece21250d2f6170732724

RPI_FIRMWARE_REPO=https://github.com/raspberrypi/firmware.git
RPI_FIRMWARE_TAG=1.20260915
RPI_FIRMWARE_COMMIT=6f0881cba8bea8ec24956a5718714730e9936ec5
RPI_FIRMWARE_URL=https://raw.githubusercontent.com/raspberrypi/firmware/$RPI_FIRMWARE_TAG/boot
KERNEL_SHA256=6efbcb3e7ba6687424dda8ba44ba151d6c76533a74cf3e1437156c85f68e9975
DTB_SHA256=a5165cb562035f479ea9f5a81cedf7b6596ea32a0598608c4dc3b77ada909c60
# The kernel's modules for the Intel igb Ethernet driver, which the PCIe
# test loads
RPI_MODULES_URL=https://raw.githubusercontent.com/raspberrypi/firmware/$RPI_FIRMWARE_TAG/modules/6.18.50-v8-16k%2B/kernel/drivers
IGB_SHA256=cbedf99c086598829f143987aaea985f58955fc3911edf9f01cc243e93f19a7c
I2C_ALGO_BIT_SHA256=ee793aca106c27d542401714761ff56b0384f3e5aabd99b38438ef94f5bd6299

die() {
    echo "firmware: $*" >&2
    exit 1
}

[ $# -eq 1 ] || die "usage: scripts/firmware DIR"
dir=$1
# find -H looks into DIR when it is a symbolic link to a directory
if [ -e "$dir" ] && [ ! -f "$dir/.check-firmware" ] &&
   [ -n "$(find -H "$dir" -mindepth 1 -maxdepth 1 -print -quit 2>&1)" ]; then
    die "$dir exists and was not made here; use a new or empty directory"
fi
mkdir -p "$dir"
touch "$dir/.check-firmware"
dir=$(cd "$dir" && pwd -P)

cross=${CROSS_COMPILE:-aarch64-linux-gnu-}
jobs=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)

# made OUTPUT PIN: OUTPUT exists and was made from PIN
made() {
    [ -f "$dir/$1" ] && [ "$(cat "$dir/.pins/$1" 2>/dev/null)" = "$2" ]
}

# record OUTPUT PIN, once OUTPUT is complete
record() {
    mkdir -p "$(dirname "$dir/.pins/$1")"
    printf '%s\n' "$2" >"$dir/.pins/$1"
}

# checkout NAME URL TAG COMMIT [PATH]: TAG of URL in DIR/src/NAME, where it
# must be COMMIT; only its directory PATH when given (a sparse clone, which
# fetches no other file)
checkout() {
    local src=$dir/src/$1 sparse=()

    [ $# -lt 5 ] || sparse=(--filter=blob:none --sparse)
    rm -rf "$src"
    git clone --quiet --depth 1 --branch "$3" -c advice.detachedHead=false \
        "${sparse[@]}" "$2" "$src"
    [ "$(git -C "$src" rev-parse HEAD)" = "$4" ] ||
        die "$2 $3 is not commit $4"
    [ $# -lt 5 ] || git -C "$src" sparse-checkout set --no-cone "/$5/"
}

# fetch FILE URL SHA256: URL in DIR/src/FILE, which must hash to SHA256
fetch() {
    local file=$dir/src/$1

    mkdir -p "$(dirname "$file")"
    curl --fail --silent --show-error --location --retry 3 -o "$file" "$2"
    [ "$(sha256sum "$file" | cut -d' ' -f1)" = "$3" ] ||
        die "$2 does not have SHA-256 $3"
}

need_cross() {
    command -v "${cross}gcc" >/dev/null ||
        die "needs ${cross}gcc (Debian and Ubuntu: gcc-aarch64-linux-gnu)"
}

# TF-A's BL31 for the Pi 5: the armstub the firmware loads at 0. A
# release build, TF-A's default: debug builds also read the DSU's
# cluster registers, which the model does not implement.
pin="tf-a $TFA_TAG $TFA_COMMIT"
if ! made bl31.bin "$pin"; then
    need_cross
    checkout tf-a "$TFA_URL" "$TFA_TAG" "$TFA_COMMIT"
    make -C "$dir/src/tf-a" -j"$jobs" CROSS_COMPILE="$cross" PLAT=rpi5 \
        BUILD_BASE="$dir/src/tf-a-build" bl31
    cp "$dir/src/tf-a-build/rpi5/release/bl31.bin" "$dir/bl31.bin"
    record bl31.bin "$pin"
fi

# U-Boot as the Pi's firmware runs it (kernel=u-boot.bin), which TF-A
# enters as its kernel. Its host tools need bison, flex, OpenSSL and
# GnuTLS.
pin="u-boot $UBOOT_TAG $UBOOT_COMMIT rpi_arm64_defconfig"
if ! made u-boot.bin "$pin"; then
    need_cross
    checkout u-boot "$UBOOT_URL" "$UBOOT_TAG" "$UBOOT_COMMIT"
    make -C "$dir/src/u-boot" O="$dir/src/u-boot-build" \
        CROSS_COMPILE="$cross" rpi_arm64_defconfig
    make -C "$dir/src/u-boot" O="$dir/src/u-boot-build" -j"$jobs" \
        CROSS_COMPILE="$cross"
    cp "$dir/src/u-boot-build/u-boot.bin" "$dir/u-boot.bin"
    record u-boot.bin "$pin"
fi

# The EDK2 release: RPI_EFI.fd is the armstub its config.txt names, with
# the device tree its config.txt places at 0x1f0000
pin="edk2 $EDK2_URL $EDK2_SHA256"
if ! made RPI_EFI.fd "$pin" || ! made edk2/bcm2712-rpi-5-b.dtb "$pin"; then
    fetch edk2.zip "$EDK2_URL" "$EDK2_SHA256"
    python3 -m zipfile -e "$dir/src/edk2.zip" "$dir/src/edk2"
    mkdir -p "$dir/edk2"
    cp "$dir/src/edk2/RPI_EFI.fd" "$dir/RPI_EFI.fd"
    cp "$dir/src/edk2/bcm2712-rpi-5-b.dtb" "$dir/edk2/bcm2712-rpi-5-b.dtb"
    record RPI_EFI.fd "$pin"
    record edk2/bcm2712-rpi-5-b.dtb "$pin"
fi

# Raspberry Pi OS's kernel and device tree, as a release of the firmware
# repository ships them
for f in kernel_2712.img:$KERNEL_SHA256 bcm2712-rpi-5-b.dtb:$DTB_SHA256; do
    name=${f%%:*}
    pin="$RPI_FIRMWARE_URL/$name ${f#*:}"
    if ! made "$name" "$pin"; then
        fetch "$name" "$RPI_FIRMWARE_URL/$name" "${f#*:}"
        cp "$dir/src/$name" "$dir/$name"
        record "$name" "$pin"
    fi
done

for f in net/ethernet/intel/igb/igb.ko.xz:$IGB_SHA256 \
         i2c/algos/i2c-algo-bit.ko.xz:$I2C_ALGO_BIT_SHA256; do
    path=${f%%:*}
    name=modules/${path##*/}
    pin="$RPI_MODULES_URL/$path ${f#*:}"
    if ! made "$name" "$pin"; then
        fetch "$name" "$RPI_MODULES_URL/$path" "${f#*:}"
        mkdir -p "$dir/modules"
        cp "$dir/src/$name" "$dir/$name"
        record "$name" "$pin"
    fi
done

# The release's overlays, as its boot partition holds them
pin="$RPI_FIRMWARE_REPO $RPI_FIRMWARE_TAG $RPI_FIRMWARE_COMMIT boot/overlays"
if ! made overlays/overlay_map.dtb "$pin"; then
    checkout firmware "$RPI_FIRMWARE_REPO" "$RPI_FIRMWARE_TAG" \
        "$RPI_FIRMWARE_COMMIT" boot/overlays
    rm -rf "$dir/overlays"
    cp -R "$dir/src/firmware/boot/overlays" "$dir/overlays"
    record overlays/overlay_map.dtb "$pin"
fi

rm -rf "$dir/src"
