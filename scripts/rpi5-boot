#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""Boot a Raspberry Pi OS SD card image on QEMU's raspi5b machine.

    scripts/rpi5-boot [OPTION...] IMAGE [-- QEMU-OPTION...]

A Raspberry Pi 5 boots from its SD card the way its bootloader reads
the card's FAT boot partition: config.txt names a kernel, a device tree
and the overlays and parameters that change it, an initramfs and the
file with the kernel's command line. rpi5-boot does the same on the
host, instead of emulating the closed firmware: it evaluates config.txt
for a Raspberry Pi 5, applies the overlays and parameters to the device
tree as the firmware's dtoverlay code does (the blob matches dtmerge's),
turns the command line's serial0 into the UART it names, and runs QEMU
with the card in the SD slot and the kernel, tree, initramfs and command
line it chose. When the guest reboots, rpi5-boot reads the card again
for the next boot, as the bootloader does: Raspberry Pi OS before
trixie rewrites cmdline.txt on its first boot and then reboots. The
next boot is the one the reset starts: before it ends QEMU, rpi5-boot
reads what the reset leaves, which the next QEMU starts with and
autoboot.txt and config.txt test: the firmware's tryboot flag (reboot
"0 tryboot"), the boot count, and the partition the OS asked for in the
watchdog's reset status (Linux passes reboot N's partition to PSCI's
SYSTEM_RESET2, which QEMU lacks). It stops when the guest powers off or
QEMU ends otherwise.

Reading the image needs mtools, and running it a QEMU with the raspi5b
machine, that is one built from this tree (QEMU 11.1 or later). The
image is the card, which the guest writes to: a raw image, decompressed
(xz -d), whose size QEMU's SD card limits to a power of two up to 2 GiB
and to a multiple of 512 KiB above (truncate -s 8G IMAGE grows one).
Anything after "--" goes to QEMU after rpi5-boot's own options (-m 8G,
-smp 2, -s ...), and a repeated option's later value wins, so "-- -M
raspi5b,serial=0x1234" changes the serial and "-- -action
reboot=reset" has QEMU reboot on its own, without rpi5-boot reading the
card again.
"""

import argparse
import json
import os
import re
import shlex
import shutil
import signal
import socket
import struct
import subprocess
import sys
import tempfile

PROG = "rpi5-boot"

# What the firmware of a Raspberry Pi 5 Model B picks by default
DEFAULT_DTB = "bcm2712-rpi-5-b.dtb"
DEFAULT_KERNELS = ("kernel_2712.img", "kernel8.img")
PLATFORM = "bcm2712"
BOARD_TYPE = 0x17
# The raspi5b machine's serial number unless "serial=" sets another
MACHINE_SERIAL = 0x0123456789abcdef
# The firmware's reboot flag that makes the next boot a tryboot
TRYBOOT_FLAG = 0x1
# PM_RSTS holds the partition the OS asked for in bits 0, 2, .. 10
RSTS_PARTITION_BITS = 6
# The partitions the bootloader walks through for one it can boot
WALK_LAST = 8

# A directory rpi5-boot writes its files to holds this file
OUTPUT_MARKER = ".rpi5-boot"


class BootError(Exception):
    """What keeps the image from booting"""


def log(message):
    print(f"{PROG}: {message}", file=sys.stderr, flush=True)


# ---------------------------------------------------------------------------
# Flattened device trees
#
# Edited as libfdt edits a blob in place, which the firmware and dtmerge
# do: a new property goes before a node's others, a new node before its
# parent's other subnodes, a property name the strings block lacks is
# appended to it. A value or name that is resized keeps what libfdt
# leaves in the padding after it: the bytes the splice moved or left
# behind. The blob this writes is the one dtmerge writes from a blob dtc
# wrote: the odd blob with NOP tokens, bytes after its end or another
# version is read, and written without them.

FDT_MAGIC = 0xd00dfeed
FDT_BEGIN_NODE, FDT_END_NODE, FDT_PROP, FDT_NOP, FDT_END = 1, 2, 3, 4, 9
# Linux reads a tree nested at most this deep (drivers/of/fdt.c)
FDT_MAX_DEPTH = 64
# Linux on arm64 takes a device tree blob of at most 2 MiB (MAX_FDT_SIZE)
FDT_MAX_SIZE = 2 << 20


class DtError(BootError):
    """A device tree that cannot be read or changed as asked"""


def be32(data, off=0):
    return struct.unpack_from(">I", data, off)[0]


def cstr(data, off=0):
    """The NUL-terminated string at @off in @data, as bytes"""
    end = data.find(b"\0", off)
    return data[off:] if end < 0 else data[off:end]


def tagalign(size):
    return (size + 3) & ~3


class Node:
    """A node: its properties ([name, value, padding] lists) and subnodes
    in the order of the blob, and the padding after its name"""

    def __init__(self, name, parent=None):
        self.name = name
        self.parent = parent
        self.pad = bytes(tagalign(len(name.encode()) + 1) -
                         len(name.encode()) - 1)
        self.props = []
        self.children = []

    def get(self, name):
        for prop in self.props:
            if prop[0] == name:
                return prop[1]
        return None

    def path(self):
        if self.parent is None:
            return "/"
        parent = self.parent.path()
        return (parent if parent != "/" else "") + "/" + self.name

    def subnode(self, name):
        """libfdt's lookup: a name without a unit address also matches a
        node's name with one"""
        for child in self.children:
            if child.name == name or ("@" not in name and
                                      child.name.startswith(name + "@")):
                return child
        return None

    def walk(self):
        """This node and its descendants, depth first, in blob order"""
        yield self
        for child in self.children:
            yield from child.walk()

    def copy(self, parent=None):
        node = Node(self.name, parent)
        node.pad = self.pad
        node.props = [list(prop) for prop in self.props]
        node.children = [child.copy(node) for child in self.children]
        return node


def phandle_of(node):
    """libfdt's fdt_get_phandle(): 0 for none"""
    for name in ("phandle", "linux,phandle"):
        value = node.get(name)
        if value is not None and len(value) == 4:
            return be32(value)
    return 0


class Tree:
    """A device tree blob, parsed"""

    def __init__(self, root, strings, rsvmap, cpuid):
        self.root = root
        self.strings = bytearray(strings)
        self.rsvmap = rsvmap
        self.cpuid = cpuid
        self.max_phandle = max((phandle_of(n) for n in root.walk()),
                               default=0)
        # Whether an overlay's references were resolved against a base tree
        self.fixups_applied = False

    @classmethod
    def parse(cls, blob, what="device tree"):
        if len(blob) > FDT_MAX_SIZE:
            raise DtError(f"{what} is {len(blob)} bytes, more than the "
                          f"{FDT_MAX_SIZE >> 20} MiB a device tree can be")
        try:
            return cls._parse(bytes(blob))
        except (struct.error, IndexError, UnicodeDecodeError,
                ValueError) as err:
            raise DtError(f"{what} is not a valid device tree blob "
                          f"({err})") from None

    @classmethod
    def _parse(cls, blob):
        (magic, total, off_struct, off_strings, off_rsv, version, _, cpuid,
         size_strings, size_struct) = struct.unpack_from(">10I", blob)
        if magic != FDT_MAGIC or total > len(blob) or version < 16 or \
           off_struct + size_struct > total or \
           off_strings + size_strings > total or off_rsv > total:
            raise ValueError("bad header")
        rsvmap, pos = [], off_rsv
        while True:
            addr, size = struct.unpack_from(">QQ", blob, pos)
            pos += 16
            if not addr and not size:
                break
            rsvmap.append((addr, size))
        strings = blob[off_strings:off_strings + size_strings]
        root, node, pos, depth = None, None, off_struct, 0
        end = off_struct + size_struct
        while pos < end:
            token = be32(blob, pos)
            pos += 4
            if token == FDT_BEGIN_NODE:
                name = cstr(blob, pos)
                if pos + len(name) >= end:
                    raise ValueError("unterminated node name")
                depth += 1
                if depth > FDT_MAX_DEPTH:
                    raise ValueError(f"nodes nested more than "
                                     f"{FDT_MAX_DEPTH} deep")
                child = Node(name.decode(), node)
                child.pad = blob[pos + len(name) + 1:
                                 pos + tagalign(len(name) + 1)]
                pos += tagalign(len(name) + 1)
                if node is None:
                    if root is not None:
                        raise ValueError("two root nodes")
                    root = child
                else:
                    node.children.append(child)
                node = child
            elif token == FDT_END_NODE:
                if node is None:
                    raise ValueError("unbalanced nodes")
                node = node.parent
                depth -= 1
            elif token == FDT_PROP:
                size, name_off = struct.unpack_from(">II", blob, pos)
                pos += 8
                if node is None or pos + size > end:
                    raise ValueError("stray property")
                name_end = strings.find(b"\0", name_off)
                if name_off >= len(strings) or name_end < 0:
                    raise ValueError("property name beyond the strings")
                name = strings[name_off:name_end].decode()
                node.props.append([name, blob[pos:pos + size],
                                   blob[pos + size:pos + tagalign(size)]])
                pos += tagalign(size)
            elif token == FDT_END:
                break
            elif token != FDT_NOP:
                raise ValueError(f"bad token {token:#x}")
        if root is None or node is not None:
            raise ValueError("no complete root node")
        return cls(root, strings, rsvmap, cpuid)

    # The blob, as fdt_pack() leaves it

    def _prop_bytes(self, prop):
        off = self.strings.find(prop[0].encode() + b"\0")
        return struct.pack(">III", FDT_PROP, len(prop[1]), max(off, 0)) + \
            prop[1] + prop[2]

    def _node_bytes(self, node):
        """@node in the blob, in pieces"""
        yield struct.pack(">I", FDT_BEGIN_NODE) + node.name.encode() + \
            b"\0" + node.pad
        for prop in node.props:
            yield self._prop_bytes(prop)
        for child in node.children:
            yield from self._node_bytes(child)
        yield struct.pack(">I", FDT_END_NODE)

    def _following(self, node, size, prop=None, child=None):
        """The @size bytes of the blob that follow a point in @node:
        before its property @prop, or its subnode @child, or else after
        its name. Past the strings block, libfdt's buffer is zeros."""
        def pieces():
            if child is None:
                for p in node.props[prop or 0:]:
                    yield self._prop_bytes(p)
            for c in node.children[child or 0:]:
                yield from self._node_bytes(c)
            yield struct.pack(">I", FDT_END_NODE)
            here = node
            while here.parent is not None:
                siblings = here.parent.children
                index = next(i for i, c in enumerate(siblings) if c is here)
                for c in siblings[index + 1:]:
                    yield from self._node_bytes(c)
                yield struct.pack(">I", FDT_END_NODE)
                here = here.parent
            yield struct.pack(">I", FDT_END)
            yield bytes(self.strings)
        out = bytearray()
        for piece in pieces():
            out += piece
            if len(out) >= size:
                break
        return bytes(out[:size]) + bytes(max(size - len(out), 0))

    def blob(self):
        body = b"".join(self._node_bytes(self.root)) + \
            struct.pack(">I", FDT_END)
        rsv = b"".join(struct.pack(">QQ", a, s) for a, s in self.rsvmap)
        rsv += bytes(16)
        off_struct = 40 + len(rsv)
        off_strings = off_struct + len(body)
        total = off_strings + len(self.strings)
        return (struct.pack(">10I", FDT_MAGIC, total, off_struct,
                            off_strings, 40, 17, 16, self.cpuid,
                            len(self.strings), len(body)) +
                rsv + body + bytes(self.strings))

    def string(self, name):
        """The offset of @name in the strings block, where libfdt finds or
        appends it"""
        key = name.encode() + b"\0"
        off = self.strings.find(key)
        if off < 0:
            off = len(self.strings)
            self.strings += key
        return off

    # libfdt's edits

    def _resize(self, node, index, size):
        """The first @size bytes of property @index's value and padding
        once fdt_splice_struct_() has resized them"""
        old = node.props[index][1] + node.props[index][2]
        if size <= len(old):
            return old[:size]
        return old + self._following(node, size - len(old), prop=index + 1)

    def setprop(self, node, name, value):
        """fdt_setprop()"""
        value = bytes(value)
        for i, prop in enumerate(node.props):
            if prop[0] == name:
                size = tagalign(len(value))
                prop[2] = self._resize(node, i, size)[len(value):]
                prop[1] = value
                return
        self.string(name)
        size = 12 + tagalign(len(value))
        gap = self._following(node, size, prop=0)
        node.props.insert(0, [name, value, gap[12 + len(value):]])

    def appendprop(self, node, name, value):
        """fdt_appendprop()"""
        value = bytes(value)
        for i, prop in enumerate(node.props):
            if prop[0] == name:
                length = len(prop[1]) + len(value)
                region = bytearray(self._resize(node, i, tagalign(length)))
                region[len(prop[1]):length] = value
                prop[1], prop[2] = bytes(region[:length]), \
                    bytes(region[length:])
                return
        self.setprop(node, name, value)

    def delprop(self, node, name):
        """fdt_delprop()"""
        for i, prop in enumerate(node.props):
            if prop[0] == name:
                del node.props[i]
                return

    def add_subnode(self, parent, name):
        """fdt_add_subnode(): after the parent's properties"""
        child = Node(name, parent)
        parent.children.insert(0, child)
        return child

    def set_name(self, node, name):
        """fdt_set_name()"""
        raw = name.encode()
        old = node.name.encode() + b"\0" + node.pad
        size = tagalign(len(raw) + 1)
        region = old[:size] if size <= len(old) else \
            old + self._following(node, size - len(old))
        node.name = name
        node.pad = region[len(raw) + 1:]

    def find(self, path, hops=0):
        """libfdt's fdt_path_offset(), aliases included; an alias naming
        an alias is followed, a few times, so that a cycle of them ends"""
        if not path or hops > 8:
            return None
        node, rest = self.root, path
        if not path.startswith("/"):
            alias, _, rest = path.partition("/")
            aliases = self.find("/aliases")
            target = aliases.get(alias) if aliases else None
            if target is None:
                return None
            node = self.find(cstr(target).decode(errors="replace"), hops + 1)
            if node is None:
                return None
        for part in rest.split("/"):
            if part:
                node = node.subnode(part)
                if node is None:
                    return None
        return node

    def by_phandle(self, phandle):
        """libfdt's fdt_node_offset_by_phandle()"""
        if phandle in (0, 0xffffffff):
            return None
        for node in self.root.walk():
            if phandle_of(node) == phandle:
                return node
        return None

    def rename(self, node, name):
        """dtoverlay_set_node_name(): before an overlay's references are
        resolved, the paths its fixups and symbols name follow the node"""
        old_path = node.path()
        old_name = node.name
        self.set_name(node, name)
        if self.fixups_applied or name == old_name:
            return
        old = old_path.encode()
        new = (old_path[:len(old_path) - len(old_name)] + name).encode()
        for holder in ("/__fixups__", "/__local_fixups__", "/__symbols__"):
            holder = self.find(holder)
            if holder is None or holder is self.root:
                continue
            for prop in holder.props:
                parts = prop[1].split(b"\0")
                changed = False
                for i, part in enumerate(parts[:-1]):
                    if part == old or part.startswith(old + b":") or \
                       part.startswith(old + b"/"):
                        parts[i] = new + part[len(old):]
                        changed = True
                if changed:
                    self.setprop(holder, prop[0], b"\0".join(parts))
        local = self.find("/__local_fixups__")
        if local is not None and local is not self.root:
            for part in old_path.split("/"):
                if part and local is not None:
                    local = local.subnode(part)
            if local is not None:
                self.set_name(local, name)


# ---------------------------------------------------------------------------
# Overlays and parameters, as the firmware applies them (and dtmerge, from
# the same code: raspberrypi/utils, dtmerge/dtoverlay.c)

OV_INTEGER, OV_BOOLEAN, OV_BOOLEAN_INV, OV_STRING, OV_OVERLAY, OV_BYTES = \
    range(1, 7)
OFFSET_SEPS = b".;:#?![{="
TRUE_WORDS = ("y", "yes", "on", "true", "down")
FALSE_WORDS = ("n", "no", "off", "false")


def c_strtoul(text, pos=0):
    """C's strtoull(text + pos, &end, 0): (value mod 2**64, end), where
    end is pos when no digits follow"""
    i, n = pos, len(text)
    while i < n and text[i] in " \t\n\v\f\r":
        i += 1
    neg = False
    if i < n and text[i] in "+-":
        neg = text[i] == "-"
        i += 1
    base, digits = 10, "0123456789"
    if text[i:i + 2].lower() == "0x" and i + 2 < n and \
       text[i + 2].lower() in "0123456789abcdef":
        base, digits, i = 16, "0123456789abcdef", i + 2
    elif text[i:i + 1] == "0":
        base, digits = 8, "01234567"
    start = i
    while i < n and text[i].lower() in digits:
        i += 1
    if i == start:
        return 0, pos
    # More digits than 2**64 has are over the range, whatever they are
    value = int(text[start:i], base) if i - start <= 32 else 1 << 64
    if value >= 1 << 64:
        return (1 << 64) - 1, i                         # ERANGE
    return (-value if neg else value) % (1 << 64), i


def c_atoi(text):
    """C's atoi(): the decimal number @text starts with, kept within an
    int, and 0 when there is none"""
    m = re.match(r"\s*([+-]?)([0-9]+)", text)
    if not m:
        return 0
    value = int(m.group(2)) if len(m.group(2)) <= 10 else 1 << 31
    value = min(value, (1 << 31) - 1)
    return -value if m.group(1) == "-" else value


def strcspn(data, pos, chars):
    """C's strcspn() at @pos: stops at any of @chars or at a NUL"""
    i = pos
    while i < len(data) and data[i] != 0 and data[i] not in chars:
        i += 1
    return i - pos


def unescape(text):
    """dtoverlay's escapes in a string parameter's value"""
    out, i = bytearray(), 0
    raw = text.encode(errors="surrogateescape")
    while i < len(raw):
        c = raw[i]
        i += 1
        if c == 0x5c:                                       # backslash
            c = raw[i] if i < len(raw) else 0
            i += 1
            if 0x30 <= c <= 0x37:
                c -= 0x30
                for _ in range(2):
                    if i < len(raw) and 0x30 <= raw[i] <= 0x37:
                        c = (c << 3) + raw[i] - 0x30
                        i += 1
                    else:
                        break
                if c > 255:
                    c = -1
            elif chr(c) in "abfnrtv":
                c = {"a": 7, "b": 8, "f": 12, "n": 10, "r": 13, "t": 9,
                     "v": 11}[chr(c)]
            elif c == ord("x"):
                hexpair = raw[i:i + 2].decode(errors="replace")
                c = int(hexpair, 16) if re.fullmatch(r"[0-9a-fA-F]{2}",
                                                     hexpair) else -1
                i += 2
            elif chr(c) not in "\\'\"":
                c = -1
            if c < 0:
                raise DtError(f"invalid escape in '{text}'")
        out.append(c)
    return bytes(out)


def extract_immediate(data, p, want):
    """A lookup table's value at @p: (end, value): a cell after a NUL, a
    quoted string or a string up to a comma or brace"""
    end, value = len(data), None
    if p + 1 < end and data[p] == 0:
        p += 1
        if p + 4 > end:
            raise DtError("truncated cell immediate")
        if want:
            value = str(struct.unpack_from(">i", data, p)[0])
        return p + 4, value
    if p < end and data[p] == ord("'"):
        p += 1
        n = strcspn(data, p, b"'")
        if p + n >= end or data[p + n] != ord("'"):
            raise DtError("unterminated quoted string")
        if want:
            value = data[p:p + n].decode(errors="replace")
        p += n + 1
    else:
        n = strcspn(data, p, b",}")
        if want:
            value = data[p:p + n].decode(errors="replace")
        p += n
    if p < end and data[p] == ord(","):
        p += 1
    return p, value


def lookup_key(data, p, key):
    """A lookup table ({key=value,...}) at @p: (value, end). As in
    dtoverlay, the key and the value share a buffer, so a default that
    comes before the key's own entry replaces the key it is matched by."""
    end, buf, found = len(data), key, 0
    while p < end and data[p] != 0 and data[p] != ord("}"):
        n = strcspn(data, p, b"=,}")
        sep = data[p + n] if p + n < end else 0
        take = False
        if not n:
            if sep and not found:
                take, found = True, 2
        elif found != 1 and data[p:p + n] == buf.encode():
            take, found = True, 1
        p += n
        if sep == ord("="):
            p, value = extract_immediate(data, p + 1, take)
            if take:
                buf = value
        elif sep == ord(","):
            p += 1
    if not found:
        raise DtError(f"lookup: no match for '{key}'")
    if p == end:
        return buf, p
    if data[p] == 0:
        raise DtError("malformed lookup")
    return buf, p + 2


def override_targets(name, data, value):
    """The targets of parameter @name set to @value, whose __overrides__
    property is @data, as dtoverlay extracts them: (type, phandle,
    property, offset, size, value) each"""
    pos, end = 0, len(data)
    while pos < end:
        if end - pos < 6:
            raise DtError(f"override {name}: data is truncated or mangled")
        phandle = be32(data, pos)
        pos += 4
        nul = data.find(b"\0", pos)
        if nul < 0:
            raise DtError(f"override {name}: string is not NUL-terminated")
        spec_pos, spec = pos, data[pos:nul]
        pos = nul + 1
        target_value = value
        if phandle == 0:
            # An overlay-wide one: fragments to enable or disable
            yield OV_OVERLAY, 0, spec.decode(errors="replace"), 0, 0, value
            continue
        if phandle & 0x80000000:
            raise DtError(f"override {name}: bad phandle {phandle:#x}")
        target_len = strcspn(spec, 0, b"={")
        name_len = strcspn(spec, 0, OFFSET_SEPS)
        prop = spec[:name_len].decode(errors="replace")
        off = size = 0
        if name_len < target_len:
            sep = spec[name_len]
            if sep == ord("?"):
                kind = OV_BOOLEAN
            elif sep == ord("!"):
                kind = OV_BOOLEAN_INV
            elif sep == ord("["):
                kind = OV_BYTES
            else:
                kind = OV_INTEGER
                off = c_atoi(spec[name_len + 1:].decode(errors="replace"))
                if off < 0:
                    raise DtError(f"negative offset in "
                                  f"'{spec.decode(errors='replace')}'")
                size = 1 << OFFSET_SEPS.index(sep)
        else:
            kind = OV_STRING
        if target_len < len(spec):
            literal_pos = spec_pos + target_len + 1
            literal = cstr(data, literal_pos)
            if spec[target_len] == ord("="):
                if kind in (OV_STRING, OV_BYTES) or literal:
                    if kind == OV_STRING and not literal and pos < end:
                        # "prop=",&label: the string that follows
                        literal = cstr(data, pos)
                        if data.find(b"\0", pos) < 0:
                            raise DtError(f"override {name}: string is "
                                          "not NUL-terminated")
                        pos += len(literal) + 1
                    target_value = literal.decode(errors="replace")
                else:
                    if pos + 4 > end:
                        raise DtError(f"override {name}: truncated cell")
                    target_value = str(be32(data, pos))
                    pos += 4
            else:
                target_value, pos = lookup_key(data, literal_pos, value)
        if kind == OV_STRING and prop == "status":
            if target_value in ("y", "yes", "on", "true", "enable", "1"):
                target_value = "okay"
            elif target_value in ("n", "no", "off", "false", "0"):
                target_value = "disabled"
        yield kind, phandle, prop, off, size, target_value


def override_one_target(tree, kind, node, prop, off, size, value):
    """dtoverlay_override_one_target(): set one target of a parameter"""
    if kind == OV_STRING:
        text = unescape(value) + b"\0"
        current = node.get(prop)
        if prop == "bootargs" and current and current[0]:
            tree.setprop(node, prop, current[:-1] + b" ")
            tree.appendprop(node, prop, text)
        elif prop == "name":
            tree.rename(node, cstr(text).decode(errors="replace"))
        else:
            tree.setprop(node, prop, text)
        return
    if kind == OV_BYTES:
        out, i = bytearray(), 0
        while i < len(value):
            if value[i] in ": \t":
                i += 1
                continue
            pair = value[i:i + 2]
            if not re.fullmatch(r"[0-9a-fA-F]{2}", pair):
                raise DtError(f"invalid bytestring at '{value[i:]}'")
            if len(out) == 32:
                raise DtError(f"bytestring '{value}' too long")
            out.append(int(pair, 16))
            i += 2
        tree.setprop(node, prop, out)
        return
    number, stop = c_strtoul(value)
    if stop != len(value):
        if value in TRUE_WORDS:
            number = 1
        elif value in FALSE_WORDS:
            number = 0
        elif value == "up":
            number = 2
        elif kind == OV_OVERLAY:
            number = int(value != "")
        else:
            raise DtError(f"invalid override value '{value}' - ignored")
    if kind == OV_INTEGER:
        current = node.get(prop) or b""
        cells = bytearray(current)
        if len(cells) < off + size:
            cells.extend(bytes(off + size - len(cells)))
        cells[off:off + size] = (number % (1 << (8 * size))).to_bytes(
            size, "big")
        if len(current) >= off + size:
            tree.setprop(node, prop, cells)
        elif prop != "reg":
            # "reg" is never created or extended: it names the node
            tree.setprop(node, prop, cells)
        if prop == "reg" and off == 0 and "@" in node.name:
            tree.rename(node, node.name[:node.name.index("@")] +
                        f"@{number & 0xffffffff:x}")
    elif kind in (OV_BOOLEAN, OV_BOOLEAN_INV):
        # A reference the property held goes with it
        if node.get(prop):
            delete_fixup(tree, f"{node.path()}:{prop}:{off}")
        if bool(number) ^ (kind == OV_BOOLEAN_INV):
            tree.setprop(node, prop, b"")
        else:
            tree.delprop(node, prop)
    elif kind == OV_OVERLAY:
        ops, i = prop, 0
        while i < len(ops):
            op = ops[i]
            if op not in "+-=!":
                raise DtError(f"invalid overlay override '{ops}'")
            frag, stop = c_strtoul(ops, i + 1)
            active = op == "+" or (op == "=" and number) or \
                (op == "!" and not number)
            fragment = tree.find(f"/fragment@{frag}") or \
                tree.find(f"/fragment-{frag}")
            if fragment is None:
                raise DtError(f"fragment {frag} not found")
            body = fragment.subnode("__dormant__" if active
                                    else "__overlay__")
            if body is not None:
                tree.rename(body, "__overlay__" if active else "__dormant__")
            i = stop if stop > i + 1 else i + 1


def delete_fixup(tree, location):
    """dtoverlay_delete_fixup(): drop the first "path:property:offset"
    entry of /__fixups__ that is @location"""
    fixups = tree.find("/__fixups__")
    if fixups is None or fixups is tree.root:
        return
    key = location.encode() + b"\0"
    for prop in fixups.props:
        entries = prop[1]
        pos = 0
        while len(entries) - pos >= len(key) - 1:
            if entries[pos:pos + len(key)] == key:
                if len(key) == len(entries):
                    tree.delprop(fixups, prop[0])
                else:
                    tree.setprop(fixups, prop[0], entries[:pos] +
                                 entries[pos + len(key):])
                return
            nul = entries.find(b"\0", pos)
            if nul < 0:
                break
            pos = nul + 1


def find_override(tree, name):
    overrides = tree.find("/__overrides__")
    return overrides.get(name) if overrides is not None else None


def apply_override(tree, name, data, value):
    """Set parameter @name, whose __overrides__ property in @tree is
    @data, to @value; targets before one that fails stay set, as in
    dtoverlay"""
    for kind, phandle, prop, off, size, target_value in \
            override_targets(name, data, value):
        node = tree.root
        if phandle:
            node = tree.by_phandle(phandle)
            if node is None:
                raise DtError(f"phandle {phandle} not found")
        override_one_target(tree, kind, node, prop, off, size,
                            target_value)


def apply_fixup_list(tree, fixups, value, relative):
    """Patch each "path:property:offset" of @fixups with @value (added to
    the cell there if @relative)"""
    for fixup in fixups.split(b"\0"):
        if not fixup:
            break
        path, _, rest = fixup.decode(errors="replace").partition(":")
        prop, _, offset = rest.partition(":")
        if not prop or not re.fullmatch(r"[0-9]{1,10}", offset):
            raise DtError(f"bad fixup '{fixup.decode(errors='replace')}'")
        node = tree.find(path)
        data = node.get(prop) if node is not None else None
        offset = int(offset)
        if data is None or offset > len(data) - 4:
            raise DtError(f"fixup '{fixup.decode(errors='replace')}' "
                          "points nowhere")
        cell = (value + (be32(data, offset) if relative else 0)) & 0xffffffff
        tree.setprop(node, prop, data[:offset] + struct.pack(">I", cell) +
                     data[offset + 4:])


def apply_local_fixups_node(tree, fixups, node, delta):
    """The newer form of __local_fixups__: a tree mirroring the overlay
    whose properties list the offsets of phandles to relocate"""
    for prop, offsets, _ in fixups.props:
        data = node.get(prop)
        if data is None:
            raise DtError(f"local fixup of missing {node.path()}:{prop}")
        data = bytearray(data)
        for i in range(0, len(offsets) - 3, 4):
            offset = be32(offsets, i)
            if offset + 4 > len(data):
                raise DtError(f"local fixup beyond {node.path()}:{prop}")
            cell = (be32(data, offset) + delta) & 0xffffffff
            data[offset:offset + 4] = struct.pack(">I", cell)
        tree.setprop(node, prop, data)
    for sub in fixups.children:
        target = node.subnode(sub.name)
        if target is None:
            raise DtError(f"local fixup of missing {node.path()}/{sub.name}")
        apply_local_fixups_node(tree, sub, target, delta)


def fixup_overlay(base, overlay):
    """dtoverlay_fixup_overlay(): point the overlay's references to the
    base's labels at their nodes, then move the overlay's own phandles
    above the base's"""
    fixups = overlay.find("/__fixups__")
    if fixups is not None and fixups.props:
        symbols = base.find("/__symbols__")
        if symbols is None:
            raise DtError("the base tree has no symbols")
        for symbol, refs, _ in fixups.props:
            if symbol.startswith("/"):
                path, what = symbol, "path"
            else:
                path, what = symbols.get(symbol), "symbol"
                if path is None:
                    raise DtError(f"can't find symbol '{symbol}'")
                path = cstr(path).decode(errors="replace")
            target = base.find(path)
            if target is None:
                raise DtError(f"{what} '{symbol}' is invalid")
            phandle = phandle_of(target)
            if not phandle:
                if base.max_phandle >= 0xfffffffe:
                    raise DtError(f"no phandle left for {what} '{symbol}'")
                base.max_phandle += 1
                phandle = base.max_phandle
                base.setprop(target, "phandle", struct.pack(">I", phandle))
            apply_fixup_list(overlay, refs, phandle, relative=False)
    delta = base.max_phandle
    for node in overlay.root.walk():
        for name in ("phandle", "linux,phandle"):
            value = node.get(name)
            # Only a well-formed one moves: dtoverlay sets it in place
            if value is not None and len(value) == 4:
                overlay.setprop(node, name, struct.pack(
                    ">I", (be32(value) + delta) & 0xffffffff))
    local = overlay.find("/__local_fixups__")
    if local is not None:
        fixup = local.get("fixup")
        if fixup is not None:
            apply_fixup_list(overlay, fixup, delta, relative=True)
        else:
            apply_local_fixups_node(overlay, local, overlay.root, delta)
    overlay.max_phandle += delta
    overlay.fixups_applied = True


def merge_fragment(base, target, body, depth=0):
    """dtoverlay_merge_fragment(): an overlay node's properties and
    subnodes onto a node of @base; bootargs are appended to"""
    keep_phandles = depth > 0 or \
        body.get("dtoverlay,preserve-phandle") is not None
    for name, value, _ in list(body.props):
        if name in ("name", "dtoverlay,preserve-phandle") or \
           (not keep_phandles and name in ("phandle", "linux,phandle")):
            continue
        current = target.get(name)
        if name == "bootargs" and current and current[0]:
            base.setprop(target, name, current[:-1] + b" ")
            base.appendprop(target, name, value)
        else:
            base.setprop(target, name, value)
    for sub in list(body.children):
        subtarget = target.subnode(sub.name)
        if subtarget is None:
            subtarget = base.add_subnode(target, sub.name)
        merge_fragment(base, subtarget, sub, depth + 1)


def fragment_target(base, overlay, fragment):
    """dtoverlay_get_target_offset(): the node a fragment targets, in
    @base, or in the overlay itself when @base is None"""
    path = fragment.get("target-path")
    if path is not None:
        if base is None:
            return None
        path = path[:-1] if path.endswith(b"\0") else path
        node = base.find(path.decode(errors="replace"))
        if node is None:
            raise DtError(f"invalid target-path '{path.decode()}'")
        return node
    target = fragment.get("target")
    if target is None:
        raise DtError("no target or target-path")
    if len(target) != 4:
        raise DtError("bad target")
    phandle = be32(target)
    if base is None:
        if phandle & 0x80000000 or phandle > overlay.max_phandle:
            return None
        return overlay.by_phandle(phandle)
    node = base.by_phandle(phandle)
    if node is None:
        raise DtError(f"invalid target (phandle {phandle})")
    return node


def apply_overlay_paths(base, holder, overlay, strings):
    """Copy @strings (an overlay's symbols or aliases) into @holder of the
    base, turning paths into a fragment into paths into its target. The
    first path whose fragment has no target ends the copy: returns its
    error, or None."""
    for name, path, _ in strings.props:
        value = path
        m = re.match(rb"(/[^/]*)/__overlay__(?=/|\0|$)", path)
        if m:
            fragment = overlay.find(m.group(1).decode(errors="replace"))
            try:
                if fragment is None:
                    raise DtError("no target or target-path")
                target = fragment_target(base, overlay, fragment)
            except DtError as err:
                return err
            rest = path[m.end():]
            target_path = target.path().encode()
            if target_path == b"/":
                rest = rest[1:]
                value = b"/" + rest if rest else b"/"
            else:
                value = target_path + rest
        if holder is not None:
            base.setprop(holder, name, value)
    return None


def filter_symbols(overlay):
    """An overlay's labels are its own, but for those it exports"""
    symbols = overlay.find("/__symbols__")
    if symbols is None:
        return
    exports = overlay.find("/__exports__")
    if exports is None:
        symbols.parent.children.remove(symbols)
        return
    exported = {prop[0] for prop in exports.props}
    symbols.props = [p for p in symbols.props if p[0] in exported]


def is_fragment(node):
    return node.name.startswith(("fragment@", "fragment-"))


def merge_overlay(base, overlay, log):
    """dtoverlay_merge_overlay(): fragments that target the overlay itself
    first, then the rest onto the base"""
    filter_symbols(overlay)
    for fragment in list(overlay.root.children):
        if not is_fragment(fragment):
            continue
        body = fragment.subnode("__overlay__")
        if body is None:
            continue
        try:
            target = fragment_target(None, overlay, fragment)
        except DtError:
            target = None
        if target is None:
            continue
        # From a copy, as dtoverlay merges from the unchanged overlay
        merge_fragment(overlay, target, body.copy(body.parent))
        overlay.rename(body, "__dormant__")
    for node in list(overlay.root.children):
        if node.name == "__symbols__":
            # Exported labels: a failure only ends the copy
            apply_overlay_paths(base, base.find("/__symbols__"), overlay,
                                node)
            continue
        if not is_fragment(node):
            continue
        body = node.subnode("__overlay__")
        if body is None:
            if node.subnode("__dormant__") is None:
                log(f"no overlay in fragment {node.name[9:]}")
            continue
        target = fragment_target(base, overlay, node)
        if target.name == "aliases":
            err = apply_overlay_paths(base, target, overlay, body)
            if err is not None:
                raise err
        else:
            merge_fragment(base, target, body)
    base.max_phandle = overlay.max_phandle


def set_synonym(tree, dst, src):
    """dtoverlay_set_synonym(): make the alias, label and parameter @dst
    copies of @src, where @src exists"""
    for holder in ("/aliases", "/__symbols__", "/__overrides__"):
        node = tree.find(holder)
        value = node.get(src) if node is not None else None
        if value is not None:
            tree.setprop(node, dst, value)


def add_i2c_synonyms(tree):
    """The parameters (and labels and aliases) i2c_arm and i2c_vc for
    I2C buses a tree names i2c0 and i2c1, which the firmware and dtmerge
    add to a tree that has no "i2c" alias"""
    aliases = tree.find("/aliases")
    if aliases is not None and aliases.get("i2c") is not None:
        return
    for dst, src in (("i2c_arm", "i2c0"), ("i2c_vc", "i2c1"),
                     ("i2c_baudrate", "i2c0_baudrate"),
                     ("i2c_arm_baudrate", "i2c0_baudrate"),
                     ("i2c_vc_baudrate", "i2c1_baudrate")):
        set_synonym(tree, dst, src)


def strncmp_equal(data, pos, literal, count):
    """C's strncmp(data + pos, literal, count) == 0"""
    for i in range(count):
        a = data[pos + i] if pos + i < len(data) else 0
        b = literal[i] if i < len(literal) else 0
        if a != b:
            return False
        if not a:
            return True
    return True


def overlay_platform(tree):
    """dtoverlay_init_map(): the platform the base tree's compatible names,
    for the overlay map: "bcm2835", "bcm2711" or "bcm2712" """
    data = tree.root.get("compatible") or b""
    families = ((b"bcm2708", b"bcm2835"), (b"bcm2709", b"bcm2835"),
                (b"bcm2710", b"bcm2835"), (b"bcm2835", b"bcm2835"),
                (b"bcm2836", b"bcm2835"), (b"bcm2837", b"bcm2835"),
                (b"bcm2711", b"bcm2711"), (b"bcm2712", b"bcm2712"))
    pos = 0
    while pos < len(data):
        comma = data.find(b",", pos)
        p = comma + 1 if comma >= 0 else pos
        count = len(data) - p
        for chip, family in families:
            if strncmp_equal(data, p, chip, count):
                return family.decode()
        nul = data.find(b"\0", p)
        pos = nul + 1 if nul >= 0 else len(data)
    return None


def remap_overlay(overlay_map, platform, name):
    """dtoverlay_remap_overlay(): the overlay (with parameters, after a
    comma) the overlay map has in place of @name, or None for one the
    platform does not support"""
    if overlay_map is None or platform is None:
        return name
    entry = overlay_map.root.subnode(name)
    if entry is None:
        return name
    value = entry.get(platform)
    if value is not None:
        value = cstr(value).decode(errors="replace")
        return value or name
    value = entry.get("renamed")
    if value is not None:
        value = cstr(value).decode(errors="replace")
        log(f"overlay '{name}' has been renamed '{value}'")
        return value
    value = entry.get("deprecated")
    if value is not None:
        log(f"overlay '{name}' is deprecated: "
            f"{cstr(value).decode(errors='replace')}")
    else:
        log(f"overlay '{name}' is not supported on the '{platform}' "
            "platform")
    return None


# ---------------------------------------------------------------------------
# The SD card image

SECTOR = 512
MIB = 1 << 20
GIB = 1 << 30
EXTENDED_TYPES = (0x05, 0x0f, 0x85)


class Partition:
    def __init__(self, number, start, size):
        self.number = number
        self.start = start
        self.size = size


def read_at(image, offset, size):
    image.seek(offset)
    return image.read(size)


def image_size(image):
    """The size of the open @image, a file or a block device"""
    return image.seek(0, os.SEEK_END)


def is_fat(sector):
    """Whether @sector is a FAT file system's boot sector"""
    if len(sector) < SECTOR or sector[510:512] != b"\x55\xaa" or \
       sector[0] not in (0xeb, 0xe9):
        return False
    sector_size = struct.unpack_from("<H", sector, 11)[0]
    cluster = sector[13]
    return sector_size in (512, 1024, 2048, 4096) and cluster and \
        not cluster & (cluster - 1) and \
        (sector[54:57] == b"FAT" or sector[82:87] == b"FAT32")


def mbr_entry(sector, index):
    """(type, first sector, sectors) of a partition table entry"""
    kind, first, count = struct.unpack_from("<4xB3xII", sector,
                                            446 + 16 * index)
    return kind, first, count


def logical_partitions(image, extended):
    """The logical partitions of the extended partition at sector
    @extended, numbered from 5 as Linux numbers them"""
    parts, ebr, seen = [], extended, set()
    while ebr not in seen and len(parts) < 64:
        seen.add(ebr)
        sector = read_at(image, ebr * SECTOR, SECTOR)
        if len(sector) < SECTOR or sector[510:512] != b"\x55\xaa":
            break
        kind, first, count = mbr_entry(sector, 0)
        if kind and count:
            parts.append(Partition(5 + len(parts), (ebr + first) * SECTOR,
                                   count * SECTOR))
        kind, first, count = mbr_entry(sector, 1)
        if not kind or not count:
            break
        ebr = extended + first
    return parts


def gpt_partitions(image):
    header = read_at(image, SECTOR, 92)
    if header[:8] != b"EFI PART":
        return []
    first_entry, entries, entry_size = struct.unpack_from("<QII", header, 72)
    if entry_size < 128 or entry_size > 4096 or entries > 1024:
        return []
    table = read_at(image, first_entry * SECTOR, entries * entry_size)
    parts = []
    for i in range(entries):
        entry = table[i * entry_size:(i + 1) * entry_size]
        if len(entry) < 128:
            break
        if entry[:16] == bytes(16):
            continue
        first, last = struct.unpack_from("<QQ", entry, 32)
        if last >= first:
            parts.append(Partition(i + 1, first * SECTOR,
                                   (last - first + 1) * SECTOR))
    return parts


def partitions(path):
    """The partitions of the image at @path, numbered as the bootloader
    numbers them: MBR primaries from 1 and logical partitions from 5, or
    GPT entries from 1. A card that is one FAT file system has only
    partition 0."""
    with open(path, "rb") as image:
        sector = read_at(image, 0, SECTOR)
        if is_fat(sector):
            return [Partition(0, 0, image_size(image))]
        if len(sector) < SECTOR or sector[510:512] != b"\x55\xaa":
            return []
        entries = [mbr_entry(sector, i) for i in range(4)]
        if any(kind == 0xee for kind, _, _ in entries):
            return gpt_partitions(image)
        parts, logical = [], []
        for i, (kind, first, count) in enumerate(entries):
            if not kind or not count:
                continue
            if kind in EXTENDED_TYPES:
                logical += logical_partitions(image, first)
            else:
                parts.append(Partition(i + 1, first * SECTOR,
                                       count * SECTOR))
        return parts + logical


def check_image(path):
    """Refuse what QEMU's SD card cannot take, saying what to do"""
    if "@@" in path:
        # mtools reads the offset after "@@" in the name it is given
        raise BootError(f"{path}: an image's path cannot contain @@")
    try:
        with open(path, "rb") as image:
            magic = image.read(6)
            size = image_size(image)
    except OSError as err:
        raise BootError(f"cannot read {path}: {err.strerror}") from None
    for signature, what, fix in ((b"\xfd7zXZ\0", "xz", "xz -dk"),
                                 (b"\x1f\x8b", "gzip", "gunzip -k"),
                                 (b"PK\x03\x04", "zip", "unzip"),
                                 (b"QFI\xfb", "qcow2", "qemu-img convert "
                                  "-O raw")):
        if magic.startswith(signature):
            raise BootError(f"{path} is {what}-compressed or not raw; "
                            f"make a raw image of it first ({fix})")
    if not size:
        raise BootError(f"{path} is empty")
    if size > 2 * GIB:
        ok, need = not size % (512 << 10), "a multiple of 512 KiB"
    else:
        ok, need = not size & (size - 1), "a power of 2"
    if not ok:
        # A power of 2 suits either rule, and leaves the guest room
        target = 1 << (size - 1).bit_length()
        target = f"{target // GIB}G" if target >= GIB else \
            f"{max(target // MIB, 1)}M"
        raise BootError(f"{path} is {size} bytes, and an SD card image's "
                        f"size must be {need}: grow it, for instance "
                        f"with truncate -s {target} {path}")


class BootFs:
    """A FAT file system in the image, read with mtools. Names are looked
    up without regard to case, as FAT and the firmware look them up."""

    def __init__(self, image, partition):
        self.image = image
        self.partition = partition
        self.spec = f"{image}@@{partition.start}"
        self.files = {}
        self.dirs = set()
        listing = self._mtools("mdir", "-/", "-b", "-a", "::/")
        for line in listing.decode(errors="surrogateescape").splitlines():
            if not line.startswith("::/"):
                continue
            path = line[3:]
            if path.endswith("/"):
                self.dirs.add(path[:-1].lower())
            elif path:
                self.files[path.lower()] = path

    def _mtools(self, command, *args, stdout=subprocess.PIPE):
        env = dict(os.environ, MTOOLS_SKIP_CHECK="1")
        try:
            proc = subprocess.run([command, "-i", self.spec, *args],
                                  stdout=stdout, stderr=subprocess.PIPE,
                                  env=env, check=False)
        except FileNotFoundError:
            raise BootError(f"{command} not found: reading the image "
                            "needs mtools") from None
        if proc.returncode:
            detail = proc.stderr.decode(errors="replace").strip()
            raise BootError(f"{command} failed on partition "
                            f"{self.partition.number} of {self.image}: "
                            f"{detail}")
        return proc.stdout

    @staticmethod
    def normalize(name):
        return "/".join(part for part in name.split("/")
                        if part and part != ".")

    @staticmethod
    def pattern(path):
        """@path as the name mcopy takes, which it matches as a pattern:
        "[" starts a character class there, and is the one character a
        FAT name can hold that does"""
        return "::/" + path.replace("[", "[[]")

    def exists(self, name):
        return self.normalize(name).lower() in self.files

    def read(self, name):
        path = self.files.get(self.normalize(name).lower())
        if path is None:
            raise BootError(f"{name} is not in the boot partition")
        return self._mtools("mcopy", "-n", self.pattern(path), "-")

    def copy(self, name, dest):
        path = self.files.get(self.normalize(name).lower())
        if path is None:
            raise BootError(f"{name} is not in the boot partition")
        with open(dest, "wb") as out:
            self._mtools("mcopy", "-n", self.pattern(path), "-", stdout=out)


# ---------------------------------------------------------------------------
# config.txt

# Longer lines are cut short, as the firmware reads them
CONFIG_LINE_MAX = 98
# The model filters a Raspberry Pi 5 Model B's firmware matches
MODEL_FILTERS = {"pi1", "pi2", "pi3", "pi3+", "pi4", "pi5", "pi400",
                 "pi500", "cm0", "cm1", "cm3", "cm3+", "cm4", "cm4s", "cm5",
                 "pi0", "pi0w", "pi02"}
OUR_MODELS = {"pi5"}
EXPRESSION = re.compile(r"([a-z0-9_]+)(?:([=<>])(\w+)|&(\w+)(?:=(\w+))?)")


class Reset:
    """What a reset leaves for the boot it starts, as the machine's
    properties of those names read it (none at power-on): the reset
    status, which holds the partition the OS asked for, the firmware's
    reboot flags and the boots so far, counted in 8 bits"""

    def __init__(self, status=None, flags=0, count=0):
        self.status = status
        self.flags = flags
        self.count = count

    @property
    def partition(self):
        """The partition the OS asked for, 0 for none"""
        rsts = self.status or 0
        return sum(((rsts >> 2 * i) & 1) << i
                   for i in range(RSTS_PARTITION_BITS))

    @property
    def tryboot(self):
        return bool(self.flags & TRYBOOT_FLAG)

    @property
    def boot_count(self):
        """The number of the boot it starts"""
        return (self.count + 1) & 0xff

    def machine_options(self):
        """The raspi5b options that make the machine's first boot this
        one"""
        if self.status is None:
            return []
        return [f"reset-status={self.status:#x}",
                f"reboot-flags={self.flags:#x}", f"boot-count={self.count}"]


class BootVars:
    """What config.txt's filters test: the boot this is, from the
    partition it boots, the partition the OS asked for, and the tryboot
    flag and boot count the reset left"""

    def __init__(self, boot_partition, partition=0, reset=None):
        reset = reset or Reset()
        self.tryboot = reset.tryboot
        self.values = {"boot_partition": boot_partition,
                       "partition": partition, "boot_arg1": 0,
                       "bootvar0": 0, "boot_count": reset.boot_count}
        for i in range(8):
            self.values[f"cust_otp{i}"] = 0

    def number(self, text):
        value, stop = c_strtoul(text)
        if stop != len(text):
            raise ValueError(text)
        return value

    def filter(self, text):
        """(kind, matched) for the conditional filter [@text]; a filter
        replaces the one of the same kind before it"""
        if text in MODEL_FILTERS:
            return "model", text in OUR_MODELS
        if text.startswith("board-type="):
            try:
                return "model", self.number(text[11:]) == BOARD_TYPE
            except ValueError:
                return "model", False
        if text == "tryboot":
            return "tryboot", self.tryboot
        if text.startswith("edid="):
            return "edid", False                # not on a Pi 5
        if re.fullmatch(r"0x[0-9a-fA-F]+", text):
            return "serial", int(text, 16) == MACHINE_SERIAL & 0xffffffff
        if re.fullmatch(r"gpio\d+=\d+", text):
            # No GPIO is sampled: the pins are not modelled
            return "gpio", False
        m = EXPRESSION.fullmatch(text)
        if m and m.group(1) in self.values:
            value = self.values[m.group(1)]
            try:
                if m.group(2) == "=":
                    return "expression", value == self.number(m.group(3))
                if m.group(2) == "<":
                    return "expression", value < self.number(m.group(3))
                if m.group(2) == ">":
                    return "expression", value > self.number(m.group(3))
                mask = self.number(m.group(4))
                if m.group(5) is None:
                    return "expression", bool(value & mask)
                return "expression", value & mask == self.number(m.group(5))
            except ValueError:
                pass
        return f"unknown {text}", False


class AutobootVars(BootVars):
    """What autoboot.txt's filters test: whether the boot is a tryboot,
    the only filter it has beside [all] and [none]"""

    def filter(self, text):
        if text == "tryboot":
            return "tryboot", self.tryboot
        return f"unknown {text}", False


class Config:
    """config.txt evaluated for this board: the settings that apply, the
    last one of each name winning, and the overlay and parameter lines
    in order. No file (@name None) is the firmware's defaults."""

    def __init__(self, fs, name, bootvars, verbose=False):
        self.fs = fs
        self.name = name
        self.bootvars = bootvars
        self.verbose = verbose
        self.values = {}
        self.dt_lines = []
        self.filters = {}
        if name is not None:
            self._read(name, 0)

    def get(self, name, default=None):
        return self.values.get(name, default)

    def number(self, name, default):
        value = self.values.get(name)
        if value is None:
            return default
        number, stop = c_strtoul(value)
        return number if stop else 0

    def _read(self, name, depth):
        if depth > 8:
            log(f"{name}: includes nest too deeply")
            return
        for raw in self.fs.read(name).split(b"\n"):
            line = raw.rstrip(b"\r")[:CONFIG_LINE_MAX]
            line = line.decode(errors="surrogateescape")
            comment = re.search(r"(^|\s)#", line)
            if comment:
                line = line[:comment.start()]
            line = line.strip()
            if not line:
                continue
            if line.startswith("["):
                end = line.find("]")
                if end > 0:
                    self._filter(line[1:end].strip().lower())
                continue
            if not all(self.filters.values()):
                continue
            m = re.match(r"([^=\s]+)\s*(?:=|\s)\s*(.*)$", line)
            key, value = (m.group(1), m.group(2)) if m else (line, "")
            key = key.lower()
            if key == "include":
                if self.fs.exists(value):
                    self._read(value, depth + 1)
                elif self.verbose:
                    log(f"{name}: no {value} to include")
            elif key in ("dtoverlay", "device_tree_overlay"):
                self.dt_lines.append(("dtoverlay", value))
            elif key in ("dtparam", "device_tree_param"):
                self.dt_lines.append(("dtparam", value))
            elif key == "ramfsfile":
                self.values["initramfs"] = value
            else:
                self.values[key] = value

    def _filter(self, text):
        if text == "all":
            self.filters = {}
        elif text == "none":
            self.filters["none"] = False
        else:
            kind, matched = self.bootvars.filter(text)
            if kind.startswith("unknown") and self.verbose:
                log(f"{self.name}: filter [{text}] is not supported, and "
                    "does not match")
            self.filters[kind] = matched


# ---------------------------------------------------------------------------
# One boot: the partition, the files config.txt names, the device tree and
# the command line

AMBA_UARTS = (b"arm,pl011", b"arm,pl011-axi", b"arm,primecell")


class Boot:
    """What one boot loads, by name in the boot partition"""

    def __init__(self, fs, config, partition=None):
        self.fs = fs
        self.config = config
        self.partition = partition
        self.os_prefix = ""
        self.overlay_dir = "overlays/"
        self.kernel = None
        self.dtb = None
        self.initramfs = []
        self.armstub = None
        self.tree = None
        self.cmdline = ""


def fat_partitions(image):
    parts = []
    with open(image, "rb") as f:
        for part in partitions(image):
            if is_fat(read_at(f, part.start, SECTOR)):
                parts.append(part)
    return parts


def boot_partition(image, requested, reset, verbose, explicit=False):
    """The partition the bootloader boots after @reset, its file system,
    and whether autoboot.txt makes a tryboot's switch at the partition,
    which then boots with its config.txt (tryboot_a_b). The partition is
    the one asked for, else the one autoboot.txt in the first FAT
    partition names, as its filters select, else the first FAT partition
    with a config.txt, which marks a Pi 5 boot partition. A partition
    asked for or named that is not one, or has no config.txt, is passed
    over for the next one up to partition 8 that has, and then for the
    first, as the bootloader's PARTITION_WALK passes over it; one asked
    for @explicit is an error."""
    parts = fat_partitions(image)
    if not parts:
        raise BootError(f"{image} has no FAT partition to boot from")
    first = BootFs(image, parts[0])

    def bootable(part):
        fs = first if part is parts[0] else BootFs(image, part)
        return fs if fs.exists("config.txt") else None

    a_b = False
    number = requested
    unbootable = "partition {}, which the reboot asks for, is not bootable"
    if first.exists("autoboot.txt"):
        autoboot = Config(first, "autoboot.txt",
                          AutobootVars(parts[0].number, reset=reset),
                          verbose)
        a_b = bool(autoboot.number("tryboot_a_b", 0))
        if not requested:
            number = autoboot.number("boot_partition", 0)
            unbootable = "autoboot.txt: partition {} is not bootable"
    if number:
        part = next((p for p in parts if p.number == number), None)
        fs = part and bootable(part)
        if fs:
            return part, fs, a_b
        if explicit and requested:
            if part:
                raise BootError(f"partition {number} has no config.txt, "
                                "so a Pi 5 will not boot from it")
            raise BootError(f"{image} has no FAT partition {number}")
        log(unbootable.format(number))
        for part in parts:
            if number < part.number <= WALK_LAST:
                fs = bootable(part)
                if fs:
                    return part, fs, a_b
    for part in parts:
        fs = bootable(part)
        if fs:
            return part, fs, a_b
    raise BootError(f"no FAT partition of {image} has a config.txt, which "
                    "a Pi 5 needs to boot from it")


def os_file(prefix, name):
    """The OS file @name under os_prefix @prefix, unless @name starts
    with "/": that names a file of the boot partition outright"""
    return name if name.startswith("/") else prefix + name


def choose_files(boot, verbose):
    """The kernel, device tree, initramfs and command line file config.txt
    names, with os_prefix where it is viable"""
    fs, config = boot.fs, boot.config
    kernel = config.get("kernel")
    dtb = config.get("device_tree")

    def kernel_at(prefix):
        names = (kernel,) if kernel else DEFAULT_KERNELS
        for name in names:
            if fs.exists(os_file(prefix, name)):
                return os_file(prefix, name)
        return None

    def dtb_at(prefix):
        name = os_file(prefix, dtb or DEFAULT_DTB)
        return name if fs.exists(name) else None

    prefix = config.get("os_prefix", "")
    if prefix and not (kernel_at(prefix) and (dtb == "" or dtb_at(prefix))):
        if verbose:
            log(f"os_prefix {prefix} ignored: no kernel and device tree "
                "there")
        prefix = ""
    boot.os_prefix = prefix
    boot.kernel = kernel_at(prefix)
    if boot.kernel is None:
        raise BootError("no kernel: the boot partition has none of " +
                        ", ".join(os_file(prefix, name) for name in
                                  ((kernel,) if kernel else DEFAULT_KERNELS)))
    if dtb != "":
        boot.dtb = dtb_at(prefix)
        if boot.dtb is None and config.number("os_check", 1):
            raise BootError(f"no device tree: the boot partition has no "
                            f"{os_file(prefix, dtb or DEFAULT_DTB)} "
                            "(os_check=0 boots without one)")

    overlay_prefix = config.get("overlay_prefix", "overlays/")
    if prefix and fs.exists(prefix + overlay_prefix + "README"):
        boot.overlay_dir = prefix + overlay_prefix
    else:
        boot.overlay_dir = overlay_prefix

    ramfs = config.get("initramfs")
    if ramfs is not None:
        names = ramfs.split()[0].split(",") if ramfs.split() else []
        for name in filter(None, names):
            if fs.exists(os_file(prefix, name)):
                boot.initramfs.append(os_file(prefix, name))
            else:
                log(f"initramfs {os_file(prefix, name)} not found")
    elif config.number("auto_initramfs", 0):
        folder, _, name = boot.kernel.rpartition("/")
        if name.startswith("kernel"):
            name = "initramfs" + os.path.splitext(name[6:])[0]
            name = f"{folder}/{name}" if folder else name
            if fs.exists(name):
                boot.initramfs.append(name)

    armstub = config.get("armstub")
    if armstub:
        if not fs.exists(armstub):
            raise BootError(f"armstub {armstub} not found")
        boot.armstub = armstub


def apply_param(base, overlay, text, verbose):
    """A parameter from a dtoverlay or dtparam line: the open overlay's,
    or else the base tree's. One neither has is skipped, as the firmware
    skips it (Raspberry Pi OS's config.txt sets "audio", which a Pi 5's
    tree lacks)."""
    name, eq, value = text.partition("=")
    if not eq:
        value = "true"
    for tree in (overlay, base):
        data = find_override(tree, name) if tree is not None else None
        if data is not None:
            try:
                apply_override(tree, name, data, value)
            except DtError as err:
                log(f"failed to set {name}={value}: {err}")
            return
    if verbose:
        log(f"unknown parameter '{name}'")


def load_overlay(boot, base, overlay_map, platform, name, verbose):
    """An overlay, remapped, loaded and fixed up for @base: (tree,
    parameters from the map), or None when it cannot be applied"""
    target = remap_overlay(overlay_map, platform, name)
    if target is None:
        return None
    target, _, params = target.partition(",")
    path = boot.overlay_dir + target + ".dtbo"
    if not boot.fs.exists(path):
        log(f"failed to load overlay '{target}': no {path}")
        return None
    try:
        overlay = Tree.parse(boot.fs.read(path), path)
        fixup_overlay(base, overlay)
    except DtError as err:
        log(f"failed to load overlay '{target}': {err}")
        return None
    if verbose:
        log(f"loaded overlay '{target}'")
    return overlay, [p for p in params.split(",") if p]


def compose_tree(boot, verbose):
    """The device tree with config.txt's overlays and parameters applied,
    in order, as the firmware applies them: a dtparam line sets the open
    overlay's parameter of that name, or else the base tree's, and the
    overlay is merged when the next dtoverlay line (or the end) closes
    it"""
    fs = boot.fs
    base = Tree.parse(fs.read(boot.dtb), boot.dtb)
    if verbose:
        log(f"loaded device tree {boot.dtb}")
    platform = overlay_platform(base)
    overlay_map = None
    map_path = boot.overlay_dir + "overlay_map.dtb"
    if platform and fs.exists(map_path):
        try:
            overlay_map = Tree.parse(fs.read(map_path), map_path)
        except DtError as err:
            log(str(err))
    add_i2c_synonyms(base)

    overlay = None

    def close():
        if overlay is not None:
            try:
                merge_overlay(base, overlay, log)
            except DtError as err:
                log(f"failed to merge an overlay: {err}")

    for kind, value in boot.config.dt_lines:
        if kind == "dtoverlay":
            close()
            overlay = None
            name, _, params = value.partition(",")
            if not name:
                continue            # "dtoverlay=" closes the overlay
            loaded = load_overlay(boot, base, overlay_map, platform, name,
                                  verbose)
            if loaded is None:
                continue
            overlay, map_params = loaded
            params = map_params + params.split(",")
        else:
            params = value.split(",")
        for param in filter(None, params):
            apply_param(base, overlay, param, verbose)
    close()

    chosen = base.find("/chosen") or base.add_subnode(base.root, "chosen")
    base.setprop(chosen, "os_prefix",
                 boot.os_prefix.encode(errors="surrogateescape") + b"\0")
    base.setprop(chosen, "overlay_prefix",
                 boot.config.get("overlay_prefix", "overlays/")
                 .encode(errors="surrogateescape") + b"\0")
    boot.tree = base


def serial_tty(tree, which):
    """The tty Linux names the UART that serial0 (the console, which the
    "console" alias names on a Pi 5) or serial1 (the Bluetooth UART) means,
    as the firmware and Raspberry Pi OS's udev rules resolve them, or None
    when that UART has no serialN alias"""
    aliases = tree.find("/aliases") if tree is not None else None
    if aliases is None:
        return None

    def alias(name):
        value = aliases.get(name)
        return cstr(value).decode(errors="replace") if value else None

    if which == 0:
        path = alias("console") or alias("serial0")
    else:
        path = alias("bluetooth")
        path = path.rpartition("/")[0] if path else alias("serial1")
    node = tree.find(path) if path else None
    if node is None:
        return None
    for name, value, _ in aliases.props:
        m = re.fullmatch(r"serial(\d+)", name)
        if m and tree.find(cstr(value).decode(errors="replace")) is node:
            compatible = (node.get("compatible") or b"").split(b"\0")
            amba = any(c in AMBA_UARTS for c in compatible)
            return ("ttyAMA" if amba else "ttyS") + m.group(1)
    return None


def kernel_cmdline(boot, root, append):
    """cmdline.txt's first line, with serial0 and serial1 turned into the
    UARTs they are (console=serial0 dropped when enable_uart=0), root=
    replaced by @root if given, and @append added"""
    name = os_file(boot.os_prefix, boot.config.get("cmdline", "cmdline.txt"))
    if boot.fs.exists(name):
        text = boot.fs.read(name).decode(errors="replace")
        text = text.split("\n")[0].strip()
    else:
        log(f"no {name}: the kernel's command line is empty")
        text = ""
    enable_uart = boot.config.number("enable_uart", 1)

    def serial(m):
        key, which, rest = m.group(2), int(m.group(3)), m.group(4)
        if which == 0 and key == "console" and not enable_uart:
            return ""
        tty = serial_tty(boot.tree, which)
        if tty is None:
            return m.group(0)
        return f"{m.group(1)}{key}={tty}{rest}"

    text = re.sub(r"(^|\s)([^\s=]+)=serial([01])((?:,\S*)?)(?=\s|$)",
                  serial, text)
    if root:
        text, count = re.subn(r"(^|\s)root=\S*",
                              lambda m: f"{m.group(1)}root={root}", text)
        if not count:
            text += f" root={root}"
    if append:
        text += " " + append
    boot.cmdline = text.strip()


# ---------------------------------------------------------------------------
# Running QEMU

# The SHUTDOWN event reasons that are a reboot, with -action reboot=shutdown
REBOOT_REASONS = ("guest-reset", "host-qmp-system-reset")
# The machine's properties that hold what a reset leaves for the next boot
RESET_PROPERTIES = ("reset-status", "reboot-flags", "boot-count")


def prepare(image, args, reset):
    """Read the card as the bootloader does for the boot @reset starts,
    which asks for a partition itself or else for the one --partition
    names: a tryboot reads tryboot.txt in place of config.txt, unless
    autoboot.txt has switched partitions for it"""
    if reset.partition:
        requested, explicit = reset.partition, False
    else:
        requested, explicit = args.partition, True
    part, fs, a_b = boot_partition(image, requested, reset, args.verbose,
                                   explicit)
    name = "tryboot.txt" if reset.tryboot and not a_b else "config.txt"
    if not fs.exists(name):
        log(f"partition {part.number} has no {name} for the tryboot: the "
            "firmware's defaults apply")
        name = None
    config = Config(fs, name, BootVars(part.number, requested or 0, reset),
                    args.verbose)
    verbose = args.verbose or bool(config.number("uart_2ndstage", 0)) or \
        bool(config.number("dtdebug", 0))
    boot = Boot(fs, config, part.number)
    choose_files(boot, verbose)
    if boot.dtb:
        compose_tree(boot, verbose)
    kernel_cmdline(boot, args.root, args.append)
    for name, default, why in (
            ("arm_64bit", 1, "a Pi 5 runs only 64-bit kernels"),
            ("pciex4_reset", 1, "RP1 and its PCIe link are not modelled"),
            ("kernel_address", None, "the kernel goes where a Pi 5's "
             "firmware puts it by default"),
            ("upstream_kernel", 0, "the firmware's own device tree names "
             "are used"),
            ("boot_ramdisk", 0, "boot.img is not read")):
        value = config.get(name)
        if value is not None and (default is None or
                                  config.number(name, default) != default):
            log(f"{config.name}: {name}={value} ignored: {why}")
    if verbose:
        log(f"boot {reset.boot_count}"
            f"{', a tryboot,' if reset.tryboot else ''} from partition "
            f"{part.number} with {config.name or 'no configuration file'}")
        log(f"partition {part.number}: kernel {boot.kernel}, device tree "
            f"{boot.dtb or '(none)'}, initramfs "
            f"{','.join(boot.initramfs) or '(none)'}")
        log(f"command line: {boot.cmdline}")
    return boot


def output_dir(path):
    """@path, made if need be, which must be new, empty, or made here"""
    if os.path.lexists(path):
        if not os.path.isdir(path):
            raise BootError(f"{path} is not a directory")
        if not os.path.isfile(os.path.join(path, OUTPUT_MARKER)) and \
           os.listdir(path):
            raise BootError(f"{path} exists and was not made by {PROG}; "
                            "use a new or empty directory")
    os.makedirs(path, exist_ok=True)
    open(os.path.join(path, OUTPUT_MARKER), "a").close()
    return path


def write_files(boot, outdir):
    """The files QEMU loads, written to @outdir: {what: path}"""
    files = {"kernel": os.path.join(outdir, "kernel.img")}
    boot.fs.copy(boot.kernel, files["kernel"])
    made = {"dtb": "device-tree.dtb", "initrd": "initramfs",
            "armstub": "armstub.bin"}
    if boot.tree is not None:
        files["dtb"] = os.path.join(outdir, made["dtb"])
        with open(files["dtb"], "wb") as out:
            out.write(boot.tree.blob())
    if boot.initramfs:
        # Several files are concatenated, as the firmware loads them
        files["initrd"] = os.path.join(outdir, made["initrd"])
        with open(files["initrd"], "wb") as out:
            for name in boot.initramfs:
                out.write(boot.fs.read(name))
    if boot.armstub:
        files["armstub"] = os.path.join(outdir, made["armstub"])
        boot.fs.copy(boot.armstub, files["armstub"])
    for what, name in made.items():
        if what not in files and os.path.lexists(os.path.join(outdir, name)):
            os.remove(os.path.join(outdir, name))
    with open(os.path.join(outdir, "cmdline.txt"), "w") as out:
        out.write(boot.cmdline + "\n")
    return files


def qemu_command(args, image, boot, files, reset):
    """QEMU's command line for @boot, the one @reset starts, from @files:
    the machine reports the partition the files come from, and starts
    with what the reset left"""
    machine = ["raspi5b"]
    if boot.armstub:
        machine.append("secure=on")
        address = boot.config.get("device_tree_address")
        if address:
            machine.append(f"dtb-address={c_strtoul(address)[0]:#x}")
    if boot.tree is None:
        machine.append("builtin-dtb=off")
    machine.append(f"boot-partition={boot.partition}")
    machine += reset.machine_options()
    cmd = [args.qemu, "-M", ",".join(machine)]
    if not args.graphics:
        cmd.append("-nographic")
    cmd += ["-drive", "if=sd,format=raw,file=" + image.replace(",", ",,")]
    if boot.armstub:
        cmd += ["-bios", files["armstub"]]
    cmd += ["-kernel", files["kernel"]]
    if "dtb" in files:
        cmd += ["-dtb", files["dtb"]]
    if "initrd" in files:
        cmd += ["-initrd", files["initrd"]]
    # A reboot ends QEMU, for the card to be read again
    cmd += ["-append", boot.cmdline, "-action", "reboot=shutdown"]
    return cmd + args.qemu_args


def run_qemu(cmd, verbose):
    """Run QEMU until the guest powers off or reboots, or QEMU ends
    otherwise: its exit status, the reason its SHUTDOWN event gave, if
    any, and for a reboot what the reset leaves for the next boot (None
    if QEMU did not say). QMP on a socket pair reports the event; the
    guest starts once it is listened for, and QEMU waits with the guest
    stopped after the event, for the machine to be read, until told to
    quit. A SIGTERM or SIGHUP stops QEMU, and then rpi5-boot; a Ctrl-C
    reaches QEMU, which ends as if powered off, and rpi5-boot ends with
    the status 130 of a command the interrupt ended; and QEMU ends with
    rpi5-boot however that ends, so that a SIGKILL leaves no QEMU
    writing to the card."""
    ours, theirs = socket.socketpair()
    fd = theirs.fileno()
    if verbose:
        log(shlex.join(cmd))
    try:
        proc = subprocess.Popen(
            cmd + ["-S", "-chardev", f"socket,id={PROG},fd={fd}",
                   "-object", f"monitor-qmp,id={PROG},chardev={PROG}",
                   "-action", "shutdown=pause",
                   "-run-with", "exit-with-parent=on"],
            pass_fds=(fd,))
    except OSError as err:
        ours.close()
        raise BootError(f"cannot run {cmd[0]}: {err.strerror}") from None
    finally:
        theirs.close()
    stopped = []

    def forward(signum, frame):
        stopped.append(signum)
        proc.send_signal(signum)

    def execute(command, ident, **arguments):
        message = {"execute": command, "id": ident}
        if arguments:
            message["arguments"] = arguments
        ours.sendall(json.dumps(message).encode() + b"\n")

    # QEMU owns the terminal: a Ctrl-C it gets as a signal ends it, and
    # then rpi5-boot, which waits for that
    handlers = {signal.SIGINT: signal.SIG_IGN, signal.SIGTERM: forward,
                signal.SIGHUP: forward}
    old = {sig: signal.signal(sig, handler)
           for sig, handler in handlers.items()}
    shutdown = False
    reason = None
    state = {}
    try:
        for line in ours.makefile("rb"):
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if not isinstance(message, dict):
                continue
            ident = message.get("id")
            if "QMP" in message:
                execute("qmp_capabilities", "capabilities")
            elif ident == "capabilities":
                execute("cont", "cont")
            elif message.get("event") == "SHUTDOWN" and not shutdown:
                # The first: quitting brings another
                shutdown = True
                reason = message.get("data", {}).get("reason")
                if reason not in REBOOT_REASONS:
                    execute("quit", "quit")
                    continue
                for name in RESET_PROPERTIES:
                    execute("qom-get", name, path="/machine", property=name)
            elif ident in RESET_PROPERTIES:
                state[ident] = message.get("return")
                if len(state) == len(RESET_PROPERTIES):
                    execute("quit", "quit")
    except OSError:
        pass
    finally:
        status = proc.wait()
        for sig, handler in old.items():
            signal.signal(sig, handler)
        ours.close()
    if stopped:
        raise SystemExit(128 + stopped[0])
    if reason == "host-signal":
        # QEMU powers the guest off on a Ctrl-C and exits 0; rpi5-boot
        # ends as the interrupted command it is
        status = 128 + signal.SIGINT
    reset = None
    if len(state) == len(RESET_PROPERTIES) and \
       all(isinstance(value, int) for value in state.values()):
        reset = Reset(state["reset-status"], state["reboot-flags"],
                      state["boot-count"])
    # A signal that ended QEMU, as a shell reports it
    return (128 - status if status < 0 else status), reason, reset


def repo_qemu():
    """The QEMU this checkout builds (make), if it is built"""
    top = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    path = os.path.join(top, "build", "qemu-system-aarch64")
    return path if os.access(path, os.X_OK) else None


def parse_args(argv):
    qemu_args = []
    if "--" in argv:
        split = argv.index("--")
        argv, qemu_args = argv[:split], argv[split + 1:]
    parser = argparse.ArgumentParser(
        prog=PROG, usage="%(prog)s [OPTION...] IMAGE [-- QEMU-OPTION...]",
        description="Boot a Raspberry Pi OS SD card image on QEMU's raspi5b "
        "machine, reading its boot partition as a Pi 5's firmware does.")
    parser.add_argument("image", metavar="IMAGE",
                        help="raw SD card image, which the guest writes to")
    parser.add_argument("--qemu", metavar="PATH",
                        default=os.environ.get("QEMU") or repo_qemu() or
                        "qemu-system-aarch64",
                        help="QEMU to run (default: $QEMU, else this "
                        "checkout's build/qemu-system-aarch64, else "
                        "qemu-system-aarch64)")
    parser.add_argument("--partition", metavar="N", type=int,
                        help="boot partition number, unless the guest asks "
                        "for another when it reboots (default: as the "
                        "bootloader picks it, with autoboot.txt)")
    parser.add_argument("--root", metavar="DEVICE",
                        help="replace the command line's root= with "
                        "root=DEVICE, such as /dev/mmcblk0p2")
    parser.add_argument("--append", metavar="ARGS", default="",
                        help="add ARGS to the kernel's command line")
    parser.add_argument("--graphics", action="store_true",
                        help="keep QEMU's display, and its default serial "
                        "and monitor, instead of -nographic")
    parser.add_argument("--no-reboot", action="store_true",
                        help="stop when the guest reboots")
    parser.add_argument("--print", dest="print_only", action="store_true",
                        help="write the files for one boot and print the "
                        "QEMU command instead of running it")
    parser.add_argument("-o", "--output", metavar="DIR",
                        help="write the kernel, device tree, initramfs and "
                        "command line to DIR, which must be new, empty or "
                        f"made by {PROG} (default: a temporary directory, "
                        "or ./rpi5-boot-files with --print)")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="say what is loaded and run, as the firmware "
                        "does with uart_2ndstage=1")
    args = parser.parse_args(argv)
    args.qemu_args = qemu_args
    return args


def stop(signum, frame):
    """SIGTERM or SIGHUP between QEMU's runs: stop, as QEMU would"""
    raise SystemExit(128 + signum)


def boot_loop(args):
    image = os.path.abspath(args.image)
    check_image(image)
    temporary = None
    if args.output or args.print_only:
        outdir = output_dir(os.path.abspath(args.output or
                                            "rpi5-boot-files"))
    else:
        outdir = temporary = tempfile.mkdtemp(prefix=f"{PROG}-")
    old = {sig: signal.signal(sig, stop)
           for sig in (signal.SIGTERM, signal.SIGHUP)}
    reset = Reset()
    try:
        while True:
            boot = prepare(image, args, reset)
            files = write_files(boot, outdir)
            cmd = qemu_command(args, image, boot, files, reset)
            if args.print_only:
                print(shlex.join(cmd))
                return 0
            status, reason, reset = run_qemu(cmd, args.verbose)
            if reason not in REBOOT_REASONS:
                return status
            if args.no_reboot:
                log("the guest rebooted: stopping, as --no-reboot asks")
                return status
            if reset is None:
                log("QEMU did not say what the reset left: the next boot "
                    "is a power-on's")
                reset = Reset()
            log("the guest rebooted: reading the card again")
    finally:
        for sig, handler in old.items():
            signal.signal(sig, handler)
        if temporary:
            shutil.rmtree(temporary, ignore_errors=True)


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        return boot_loop(args)
    except BootError as err:
        log(str(err))
        return 1
    except KeyboardInterrupt:
        return 128 + signal.SIGINT


if __name__ == "__main__":
    sys.exit(main())
