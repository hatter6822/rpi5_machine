#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Manage the pinned QEMU work tree: apply/remove this repository's patch
# series and overlay, report their state, and create or refresh patches.
#
# overlay/  New files, laid out as in the QEMU tree. They are symlinked into
#           qemu/ so that edits made from either side land in this repository.
# patches/  Changes to existing QEMU files, as a git format-patch series
#           applied in file name order. Like the commits of a series, a
#           patch may change a file that an earlier one also changes: each
#           is generated against the tree with every earlier patch applied,
#           and with the changes of later patches taken back out.
#
# The exact revision of every patch applied to qemu/ is recorded in the
# submodule's git directory (outside the work tree). That record, not the
# current patches/ content, says what the tree holds: when a checkout or
# pull changes a patch, 'apply' reverts the recorded revision before
# applying the new one, and local edits to patched files are left alone
# while their patch is unchanged.

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
QEMU="$ROOT/qemu"
OVERLAY="$ROOT/overlay"
PATCHES="$ROOT/patches"
SERIES="$ROOT/series"
EXPORT_MARKER=.qemu-tree-export     # marks a directory export may empty
                                    # (and 'make distclean' remove)

die() { printf 'qemu-tree: %s\n' "$*" >&2; exit 1; }
info() { printf '  %-8s %s\n' "$1" "$2"; }
qgit() { git -C "$QEMU" "$@"; }

usage() {
    cat <<EOF
usage: scripts/qemu-tree <command> [args]

  apply                 apply patches/ and link overlay/ into qemu/
  unapply               undo 'apply', restoring the pristine pinned tree
  status                show patch, overlay and unmanaged-change state
  new <slug> <file>...  turn current edits of existing QEMU files into a
                        new patch (commit message opens in \$EDITOR)
  refresh <patch> [<file>...]
                        regenerate <patch> from the qemu/ work tree, from
                        the files it changes plus any <file> named
  export [-v <n>] [--signoff] [--build] <dir>
                        write the upstream series to <dir>: each patch
                        with the overlay files series/series.map assigns
                        to it, as one commit on the pinned revision, plus
                        a cover letter from series/cover.txt; check that
                        it applies with git am and passes checkpatch.
                        --build builds every commit, --signoff adds your
                        Signed-off-by (git config user.name and .email)
EOF
}

patch_list() {
    find "$PATCHES" -maxdepth 1 -name '*.patch' | LC_ALL=C sort
}

patch_files() {
    sed -n 's|^diff --git a/\(.*\) b/.*$|\1|p' "$1"
}

overlay_list() {
    (cd "$OVERLAY" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)
}

# Relative link target from qemu/<rel> to overlay/<rel>
link_target() {
    realpath -m --relative-to="$(dirname "$QEMU/$1")" "$OVERLAY/$1"
}

is_applied() {
    qgit apply --reverse --check "$1" >/dev/null 2>&1
}

# has_local_edits <patch>: the tree's diff of the patch's files differs from
# the patch itself. Unlike is_applied, this also sees edits outside the
# patch's hunks. An edit to a file that several patches change counts for
# each of them, since refreshing any one of them would take it in. 'index'
# lines are skipped: their hash abbreviation length depends on the clone.
has_local_edits() {
    local -a files trees
    local staged
    mapfile -t files < <(patch_files "$1")
    # Failing to stage means a later patch's lines were edited
    staged=$(stage_trees "$(basename "$1")" "${files[@]}" 2>/dev/null) ||
        return 0
    read -ra trees <<<"$staged"
    ! cmp -s <(sed -n '/^diff --git /,$p' "$1" | grep -v '^index ') \
             <(qgit diff --no-color --no-ext-diff "${trees[@]}" -- \
                   "${files[@]}" | grep -v '^index ')
}

# applied_revision <patch>: the recorded revision of <patch>, if any
applied_revision() {
    local r
    r="$APPLIED/$(basename "$1")"
    [ -f "$r" ] && printf '%s\n' "$r"
}

# touches_any <patch> <file>...: <patch> changes at least one of <file>...
touches_any() {
    local p=$1
    shift
    grep -qxF -f <(printf '%s\n' "$@") <(patch_files "$p")
}

# stage_trees <name> <file>...: print the base and result trees of the
# patch named <name> as it would be generated from qemu/ for <file>...
# The base is HEAD plus the applied revision of every patch ordered before
# <name>; the result is the base with <file>... as qemu/ holds them, minus
# the changes of later applied patches to those files. Only a temporary
# index and the submodule's object store are used; qemu/ is not touched.
# Call it in a command substitution: it cleans up on exit of the subshell.
stage_trees() {
    local name=$1 idx p r f blob mode base
    shift
    idx=$(mktemp -d)/index
    # shellcheck disable=SC2064 # expand now: $idx is local
    trap "rm -rf '${idx%/index}'" EXIT
    local -a inc=() later=()
    for f; do inc+=(--include="$f"); done

    GIT_INDEX_FILE=$idx qgit read-tree HEAD
    while IFS= read -r p; do
        if [ "$(basename "$p")" \< "$name" ]; then
            r=$(applied_revision "$p") ||
                die "$(basename "$p") is not applied; run 'make apply' first"
            GIT_INDEX_FILE=$idx qgit apply --cached "$r"
        elif [ "$(basename "$p")" != "$name" ] &&
             r=$(applied_revision "$p") && touches_any "$r" "$@"; then
            later=("$r" "${later[@]}")  # newest first, for reverting
        fi
    done < <(patch_list)
    base=$(GIT_INDEX_FILE=$idx qgit write-tree)

    for f; do
        if [ -f "$QEMU/$f" ]; then
            blob=$(qgit hash-object -w -- "$f")
            mode=100644
            [ ! -x "$QEMU/$f" ] || mode=100755
            GIT_INDEX_FILE=$idx qgit update-index --add \
                --cacheinfo "$mode,$blob,$f"
        else
            GIT_INDEX_FILE=$idx qgit update-index --force-remove -- "$f"
        fi
    done
    for r in "${later[@]}"; do
        GIT_INDEX_FILE=$idx qgit apply --cached --reverse "${inc[@]}" "$r" ||
            die "cannot separate $name from the later $(basename "$r")," \
                "which changes the same lines; edit the later patch instead"
    done
    printf '%s %s\n' "$base" "$(GIT_INDEX_FILE=$idx qgit write-tree)"
}

# record <patch>: note that this exact revision is now applied to qemu/
record() {
    cp "$1" "$APPLIED/$(basename "$1")"
}

# revert_recorded <record>: undo a recorded revision and forget it
revert_recorded() {
    local r=$1 name
    name=$(basename "$r")
    if qgit apply --reverse --check "$r" 2>/dev/null; then
        qgit apply --reverse "$r"
        info revert "$name"
    elif ! qgit apply --check "$r" 2>/dev/null; then
        die "cannot revert the applied revision of $name: files it touches" \
            "have local edits. Save them (e.g. 'git -C qemu diff >" \
            "edits.diff'), restore the files with 'git -C qemu checkout --'," \
            "then run this again"
    fi
    # else: its files are already pristine, so only the record is stale
    rm -f "$r"
}

# revert_stale_records: undo recorded revisions that patches/ no longer
# holds, together with every later recorded patch that shares a file with
# one being undone (its hunks were made on top of it)
revert_stale_records() {
    local r p
    local -a out=() files=()
    while IFS= read -r r; do
        p="$PATCHES/$(basename "$r")"
        if [ ! -f "$p" ] || ! cmp -s "$r" "$p" ||
           { [ ${#files[@]} -gt 0 ] && touches_any "$r" "${files[@]}"; }; then
            out=("$r" "${out[@]}")
            mapfile -t -O "${#files[@]}" files < <(patch_files "$r")
        fi
    done < <(find "$APPLIED" -name '*.patch' | LC_ALL=C sort)
    for r in "${out[@]}"; do
        revert_recorded "$r"
    done
}

check_tree() {
    [ -e "$QEMU/.git" ] ||
        die "qemu/ is not checked out; run 'git submodule update --init qemu'"
    local state
    state="$(qgit rev-parse --absolute-git-dir)/qemu-tree"
    APPLIED="$state/applied"
    mkdir -p "$APPLIED"

    local pinned head
    pinned=$(git -C "$ROOT" ls-tree HEAD qemu | awk '{ print $3 }')
    head=$(qgit rev-parse HEAD)

    # Records describe the tree of one QEMU commit. Once qemu/ moves (a
    # bump, or a checkout), forget them: each patch is then re-derived from
    # the tree, and one that no longer applies is an error, not an edit.
    if [ -f "$state/head" ] && [ "$(cat "$state/head")" != "$head" ]; then
        printf 'qemu-tree: qemu/ moved to %s; re-checking every patch\n' \
            "${head:0:12}" >&2
        rm -f "$APPLIED"/*.patch
    fi
    echo "$head" >"$state/head"
    if [ -n "$pinned" ] && [ "$pinned" != "$head" ]; then
        printf 'qemu-tree: warning: qemu/ is at %s, pinned commit is %s\n' \
            "${head:0:12}" "${pinned:0:12}" >&2
    fi
}

cmd_apply() {
    check_tree

    # Quiet unless something changes: the Makefile runs this before builds
    revert_stale_records

    local p rel dst
    while IFS= read -r p; do
        if [ -f "$APPLIED/$(basename "$p")" ]; then
            # Recorded: re-apply only if its files were restored behind our
            # back; anything else is the tree holding it, possibly with local
            # edits in progress
            if ! is_applied "$p" && qgit apply --check "$p" 2>/dev/null; then
                qgit apply --whitespace=error-all "$p"
                info apply "$(basename "$p")"
            fi
        elif is_applied "$p"; then
            record "$p"                 # applied before records existed
        elif qgit apply --check "$p" 2>/dev/null; then
            qgit apply --whitespace=error-all "$p"
            record "$p"
            info apply "$(basename "$p")"
        else
            die "$(basename "$p") does not apply; see 'git -C qemu apply -v $p'"
        fi
    done < <(patch_list)

    while IFS= read -r rel; do
        dst="$QEMU/$rel"
        if [ -L "$dst" ]; then
            [ "$(readlink "$dst")" = "$(link_target "$rel")" ] && continue
        elif [ -e "$dst" ]; then
            die "overlay/$rel shadows an upstream file; change it with a patch"
        fi
        mkdir -p "$(dirname "$dst")"
        ln -sfn "$(link_target "$rel")" "$dst"
        info link "$rel"
    done < <(overlay_list)
}

# Symlinks in qemu/ that resolve into overlay/, including stale ones
overlay_links() {
    local link
    while IFS= read -r -d '' link; do
        case "$(realpath -m "$link")" in
        "$OVERLAY"/*) printf '%s\n' "${link#"$QEMU"/}" ;;
        esac
    done < <(find "$QEMU" -path "$QEMU/.git" -prune -o -type l -print0)
}

cmd_unapply() {
    check_tree

    local rel p
    while IFS= read -r rel; do
        rm -f "$QEMU/$rel"
        info unlink "$rel"
    done < <(overlay_links)

    while IFS= read -r p; do
        revert_recorded "$p"
    done < <(find "$APPLIED" -name '*.patch' | LC_ALL=C sort -r)

    # Trees patched before revisions were recorded
    while IFS= read -r p; do
        if is_applied "$p"; then
            qgit apply --reverse "$p"
            info revert "$(basename "$p")"
        fi
    done < <(patch_list | LC_ALL=C sort -r)
}

cmd_status() {
    check_tree

    local p rel managed file
    managed=$(mktemp)
    trap 'rm -f "$managed"' RETURN

    echo "patches:"
    local r
    while IFS= read -r p; do
        r="$APPLIED/$(basename "$p")"
        if [ -f "$r" ] && cmp -s "$r" "$p" && has_local_edits "$p"; then
            info applied "$(basename "$p") (with local edits)"
        elif [ -f "$r" ] && cmp -s "$r" "$p"; then
            info applied "$(basename "$p")"
        elif [ -f "$r" ]; then
            info outdated "$(basename "$p") (another revision is applied)"
        elif is_applied "$p"; then
            info applied "$(basename "$p") (unrecorded)"
        else
            info pending "$(basename "$p")"
        fi
        patch_files "$p" >>"$managed"
    done < <(patch_list)
    while IFS= read -r r; do
        [ -f "$PATCHES/$(basename "$r")" ] ||
            info removed "$(basename "$r") (still applied)"
    done < <(find "$APPLIED" -name '*.patch' | LC_ALL=C sort)

    echo "overlay:"
    while IFS= read -r rel; do
        if [ -L "$QEMU/$rel" ]; then
            info linked "$rel"
        else
            info missing "$rel"
        fi
        echo "$rel" >>"$managed"
    done < <(overlay_list)
    while IFS= read -r rel; do
        [ -e "$OVERLAY/$rel" ] || info stale "$rel"
    done < <(overlay_links)

    echo "unmanaged changes in qemu/:"
    qgit status --porcelain | cut -c4- | while IFS= read -r file; do
        grep -qxF "$file" "$managed" || info changed "$file"
    done
}

cmd_new() {
    [ $# -ge 2 ] || die "usage: new <slug> <file>..."
    check_tree

    local slug=$1 last num out
    shift
    last=$(patch_list | tail -n1)
    last=$(basename "${last:-0000}")
    num=$(printf '%04d' $((10#${last:0:4} + 1)))
    out="$PATCHES/$num-$slug.patch"

    local msg
    msg=$(mktemp)
    trap 'rm -f "$msg"' RETURN
    printf 'subsystem: Summary in the imperative mood\n\nWhy the change is needed.\n' >"$msg"
    # The editor git itself would use; like git, allow arguments in it
    local editor
    editor=$(git -C "$ROOT" var GIT_EDITOR)
    eval "$editor \"\$msg\""

    write_patch "$out" "$msg" "$(git -C "$ROOT" var GIT_AUTHOR_IDENT |
        sed 's/> .*/>/')" "$@"
    record "$out"
    info new "$(basename "$out")"
}

cmd_refresh() {
    [ $# -ge 1 ] || die "usage: refresh <patch> [<file>...]"
    local p=$1
    shift
    [ -f "$p" ] || p="$PATCHES/$p"
    [ -f "$p" ] || die "no such patch: $p"
    check_tree

    # git mailinfo splits the mail into headers (stdout), body and diff,
    # unfolding wrapped Subject lines and stripping the [PATCH] prefix.
    local tmp headers author date subject
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    headers=$(git mailinfo "$tmp/body" "$tmp/diff" <"$p")
    author="$(header Author "$headers") <$(header Email "$headers")>"
    date=$(header Date "$headers")
    subject=$(header Subject "$headers")
    { printf '%s\n\n' "$subject"; cat "$tmp/body"; } >"$tmp/msg"

    local -a files
    mapfile -t files < <({ patch_files "$p"; [ $# -eq 0 ] ||
                           printf '%s\n' "$@"; } | LC_ALL=C sort -u)
    GIT_AUTHOR_DATE="$date" write_patch "$p" "$tmp/msg" "$author" "${files[@]}"
    record "$p"
    info refresh "$(basename "$p")"
}

# header <name> <mailinfo-output>: the value of one "Name: value" line
header() {
    sed -n "s/^$1: //p" <<<"$2"
}

# write_patch <out> <message-file> <author> <file>...: format the changes
# of <file>... in qemu/ that belong to the patch named like <out> (see
# stage_trees) as a single git format-patch file. GIT_AUTHOR_DATE, when
# set, dates the patch.
write_patch() {
    local out=$1 msg=$2 author=$3 staged base tree
    shift 3
    staged=$(stage_trees "$(basename "$out")" "$@")
    read -r base tree <<<"$staged"
    [ "$base" != "$tree" ] || die "no changes in: $*"

    # Commit objects only, never checked out, so qemu/ is left untouched;
    # neither needs the user's git identity
    local parent commit name email
    name=${author% <*}
    email=${author##*<}
    email=${email%>}
    parent=$(GIT_AUTHOR_NAME=$name GIT_AUTHOR_EMAIL=$email \
             GIT_COMMITTER_NAME=qemu-tree \
             GIT_COMMITTER_EMAIL=qemu-tree@localhost \
             qgit commit-tree "$base" -m base)
    commit=$(GIT_AUTHOR_NAME=$name GIT_AUTHOR_EMAIL=$email \
             GIT_COMMITTER_NAME=qemu-tree \
             GIT_COMMITTER_EMAIL=qemu-tree@localhost \
             qgit commit-tree "$tree" -p "$parent" -F "$msg")
    qgit format-patch -q -1 --no-signature --zero-commit -N --stdout \
        "$commit" >"$out"
}

# patch_slug <patch>: its file name without the number and extension
patch_slug() {
    local n
    n=$(basename "$1" .patch)
    printf '%s\n' "${n#[0-9][0-9][0-9][0-9]-}"
}

cmd_export() {
    local version=1 signoff='' build='' out
    while [ $# -gt 0 ]; do
        case $1 in
        -v) [ $# -ge 2 ] || die "-v needs a number"
            version=$2; shift 2 ;;
        --signoff) signoff=1; shift ;;
        --build) build=1; shift ;;
        -*) die "export: unknown option $1" ;;
        *) break ;;
        esac
    done
    [ $# -eq 1 ] || die "usage: export [-v <n>] [--signoff] [--build] <dir>"
    [[ $version =~ ^[1-9][0-9]*$ ]] || die "-v needs a number"
    out=$(realpath -m "$1")
    # The directory is emptied first, so it must be new, empty, or an
    # earlier export: marked, or (from before the marker) holding
    # nothing but numbered patches
    [ ! -e "$out" ] || [ -d "$out" ] || die "$out is not a directory"
    if [ -e "$out" ] && [ ! -f "$out/$EXPORT_MARKER" ] &&
       [ -n "$(find "$out" -mindepth 1 -maxdepth 1 \
                 ! -name '[0-9][0-9][0-9][0-9]-*.patch' -print -quit 2>&1)" ]; then
        die "$out exists and was not made by 'export'; give a new or empty directory"
    fi
    local map="$SERIES/series.map" cover="$SERIES/cover.txt"
    [ -f "$map" ] || die "needs $map"
    [ -f "$cover" ] || die "needs $cover"

    # Which overlay files each patch brings; each file exactly once
    local -A files_of=() owner=() slugs=()
    local line slug f p
    while IFS= read -r line; do
        line=${line%%#*}
        [ -n "${line//[[:space:]]/}" ] || continue
        [[ $line == *:* ]] || die "series.map: no ':' in: $line"
        slug=${line%%:*}
        slug=${slug//[[:space:]]/}
        [ -z "${files_of[$slug]+x}" ] || die "series.map: $slug listed twice"
        files_of[$slug]=${line#*:}
        for f in ${files_of[$slug]}; do
            [ -f "$OVERLAY/$f" ] || die "series.map: no overlay/$f"
            [ -z "${owner[$f]:-}" ] ||
                die "series.map: $f is in both ${owner[$f]} and $slug"
            owner[$f]=$slug
        done
    done <"$map"
    while IFS= read -r f; do
        [ -n "${owner[$f]:-}" ] || die "series.map: overlay/$f is in no patch"
    done < <(overlay_list)
    while IFS= read -r p; do
        slugs[$(patch_slug "$p")]=1
    done < <(patch_list)
    for slug in "${!files_of[@]}"; do
        [ -n "${slugs[$slug]:-}" ] || die "series.map: no patch named $slug"
    done

    # Commits need a committer, and a Signed-off-by must be the user's own.
    # They are made in a worktree of qemu/, which has a config of its own,
    # so resolve the identity here and hand it on explicitly.
    local ident name email
    if ident=$(git -C "$ROOT" -c user.useConfigOnly=true \
               var GIT_COMMITTER_IDENT 2>/dev/null); then
        name=${ident% <*}
        email=${ident#*<}
        email=${email%%>*}
    elif [ -n "$signoff" ]; then
        die "--signoff needs git config user.name and user.email"
    else
        name=qemu-tree
        email=qemu-tree@localhost
    fi
    export GIT_COMMITTER_NAME=$name GIT_COMMITTER_EMAIL=$email

    # The series is based on the revision the superproject pins, whatever
    # qemu/ has checked out
    local base tmp tree
    base=$(git -C "$ROOT" ls-tree HEAD qemu | awk '{ print $3 }')
    [ -n "$base" ] || die "the superproject does not pin a qemu/ revision"
    qgit cat-file -e "$base^{commit}" 2>/dev/null ||
        die "pinned revision ${base:0:12} is not in qemu/; run 'git submodule update qemu'"
    tmp=$(mktemp -d)
    tree="$tmp/tree"
    # shellcheck disable=SC2064 # expand now: $tmp is local
    trap "qgit worktree remove --force '$tree' 2>/dev/null; \
          qgit worktree remove --force '$tmp/check' 2>/dev/null; \
          rm -rf '$tmp'" EXIT
    qgit worktree add -q --detach "$tree" "$base"

    if [ -n "$build" ]; then
        info configure "$tmp/build"
        mkdir "$tmp/build"
        (cd "$tmp/build" && "$tree/configure" --target-list=aarch64-softmmu \
            --disable-docs --disable-user >"$tmp/configure.log" 2>&1) ||
            { cat "$tmp/configure.log" >&2; die "configure failed"; }
    fi

    local -a am=(am --quiet)
    [ -z "$signoff" ] || am+=(--signoff)
    while IFS= read -r p; do
        git -C "$tree" "${am[@]}" "$p" ||
            die "$(basename "$p") does not apply to the pinned revision"
        slug=$(patch_slug "$p")
        if [ -n "${files_of[$slug]:-}" ]; then
            for f in ${files_of[$slug]}; do
                mkdir -p "$(dirname "$tree/$f")"
                cp "$OVERLAY/$f" "$tree/$f"
                git -C "$tree" add "$f"
            done
            git -C "$tree" commit --quiet --amend --no-edit
        fi
        info commit "$(git -C "$tree" log -1 --format=%s)"
        if [ -n "$build" ]; then
            ninja -C "$tmp/build" qemu-system-aarch64 >"$tmp/build.log" 2>&1 ||
                { tail -n 40 "$tmp/build.log" >&2
                  die "does not build: $(basename "$p")"; }
            info built "$(basename "$p")"
        fi
    done < <(patch_list)

    local -a fp=(format-patch --quiet --cover-letter --base="$base"
                 -o "$out")
    [ "$version" = 1 ] || fp+=(-v "$version")
    [ ! -d "$out" ] || find "$out" -mindepth 1 -delete
    mkdir -p "$out"
    touch "$out/$EXPORT_MARKER"
    git -C "$tree" "${fp[@]}" "$base..HEAD"

    # The cover letter: the first line of cover.txt is its subject
    local letter subject
    letter=$(find "$out" -name '*0000-cover-letter.patch')
    subject=$(head -n1 "$cover")
    awk -v subject="$subject" -v blurb="$cover" '
        /\*\*\* SUBJECT HERE \*\*\*/ { sub(/\*\*\* SUBJECT HERE \*\*\*/, subject) }
        $0 == "*** BLURB HERE ***" {
            getline l < blurb       # the subject line
            while ((getline l < blurb) > 0) {
                if (started || l != "") { print l; started = 1 }
            }
            next
        }
        { print }' "$letter" >"$tmp/letter"
    mv "$tmp/letter" "$letter"

    # What reviewers get: it applies to the pinned revision as is...
    local -a patches
    mapfile -t patches < <(find "$out" -name '*.patch' ! -name '*0000-*' |
                           LC_ALL=C sort)
    qgit worktree add -q --detach "$tmp/check" "$base"
    git -C "$tmp/check" am --quiet "${patches[@]}" ||
        die "the exported series does not apply with git am"
    [ "$(git -C "$tmp/check" rev-parse 'HEAD^{tree}')" = \
      "$(git -C "$tree" rev-parse 'HEAD^{tree}')" ] ||
        die "the exported series does not reproduce the tree"

    # ...and passes checkpatch (from the result, for its MAINTAINERS)
    local -a cp=()
    [ -n "$signoff" ] || cp+=(--no-signoff)
    (cd "$tree" && scripts/checkpatch.pl --terse "${cp[@]}" "${patches[@]}") ||
        die "checkpatch found errors"
    info exported "${#patches[@]} patches and a cover letter in $out"
}

[ $# -ge 1 ] || { usage; exit 1; }
cmd=$1
shift
case "$cmd" in
apply | unapply | status | new | refresh | export) "cmd_$cmd" "$@" ;;
-h | --help | help) usage ;;
*) usage >&2; exit 1 ;;
esac
