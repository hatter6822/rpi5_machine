#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Manage the pinned QEMU work tree: apply/remove this repository's patch
# series and overlay, report their state, and create or refresh patches.
#
# overlay/  New files, laid out as in the QEMU tree. They are symlinked into
#           qemu/ so that edits made from either side land in this repository.
# patches/  Changes to existing QEMU files, as a git format-patch series
#           applied in file name order. Patches must touch disjoint files so
#           that each can be refreshed independently.
#
# The exact revision of every patch applied to qemu/ is recorded in the
# submodule's git directory (outside the work tree). That record, not the
# current patches/ content, says what the tree holds: when a checkout or
# pull changes a patch, 'apply' reverts the recorded revision before
# applying the new one, and local edits to patched files are left alone
# while their patch is unchanged.

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
QEMU="$ROOT/qemu"
OVERLAY="$ROOT/overlay"
PATCHES="$ROOT/patches"

die() { printf 'qemu-tree: %s\n' "$*" >&2; exit 1; }
info() { printf '  %-8s %s\n' "$1" "$2"; }
qgit() { git -C "$QEMU" "$@"; }

usage() {
    cat <<EOF
usage: scripts/qemu-tree <command> [args]

  apply                 apply patches/ and link overlay/ into qemu/
  unapply               undo 'apply', restoring the pristine pinned tree
  status                show patch, overlay and unmanaged-change state
  new <slug> <file>...  turn current edits of existing QEMU files into a
                        new patch (commit message opens in \$EDITOR)
  refresh <patch>       regenerate <patch> from the qemu/ work tree
EOF
}

patch_list() {
    find "$PATCHES" -maxdepth 1 -name '*.patch' | LC_ALL=C sort
}

patch_files() {
    sed -n 's|^diff --git a/\(.*\) b/.*$|\1|p' "$1"
}

overlay_list() {
    (cd "$OVERLAY" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)
}

# Relative link target from qemu/<rel> to overlay/<rel>
link_target() {
    realpath -m --relative-to="$(dirname "$QEMU/$1")" "$OVERLAY/$1"
}

is_applied() {
    qgit apply --reverse --check "$1" >/dev/null 2>&1
}

# record <patch>: note that this exact revision is now applied to qemu/
record() {
    cp "$1" "$APPLIED/$(basename "$1")"
}

# revert_recorded <record>: undo a recorded revision and forget it
revert_recorded() {
    local r=$1 name
    name=$(basename "$r")
    if qgit apply --reverse --check "$r" 2>/dev/null; then
        qgit apply --reverse "$r"
        info revert "$name"
    elif ! qgit apply --check "$r" 2>/dev/null; then
        die "cannot revert the applied revision of $name: files it touches" \
            "have local edits. Save them (e.g. 'git -C qemu diff >" \
            "edits.diff'), restore the files with 'git -C qemu checkout --'," \
            "then run this again"
    fi
    # else: its files are already pristine, so only the record is stale
    rm -f "$r"
}

# revert_stale_records: undo recorded revisions that patches/ no longer holds
revert_stale_records() {
    local r p
    while IFS= read -r r; do
        p="$PATCHES/$(basename "$r")"
        if [ ! -f "$p" ] || ! cmp -s "$r" "$p"; then
            revert_recorded "$r"
        fi
    done < <(find "$APPLIED" -name '*.patch' | LC_ALL=C sort -r)
}

check_tree() {
    [ -e "$QEMU/.git" ] ||
        die "qemu/ is not checked out; run 'git submodule update --init qemu'"
    APPLIED="$(qgit rev-parse --absolute-git-dir)/qemu-tree/applied"
    mkdir -p "$APPLIED"

    local pinned head
    pinned=$(git -C "$ROOT" ls-tree HEAD qemu | awk '{ print $3 }')
    head=$(qgit rev-parse HEAD)
    if [ -n "$pinned" ] && [ "$pinned" != "$head" ]; then
        printf 'qemu-tree: warning: qemu/ is at %s, pinned commit is %s\n' \
            "${head:0:12}" "${pinned:0:12}" >&2
    fi
}

cmd_apply() {
    check_tree

    # Quiet unless something changes: the Makefile runs this before builds
    revert_stale_records

    local p rel dst
    while IFS= read -r p; do
        if [ -f "$APPLIED/$(basename "$p")" ]; then
            # Recorded: re-apply only if its files were restored behind our
            # back; anything else is the tree holding it, possibly with local
            # edits in progress
            if ! is_applied "$p" && qgit apply --check "$p" 2>/dev/null; then
                qgit apply --whitespace=error-all "$p"
                info apply "$(basename "$p")"
            fi
        elif is_applied "$p"; then
            record "$p"                 # applied before records existed
        elif qgit apply --check "$p" 2>/dev/null; then
            qgit apply --whitespace=error-all "$p"
            record "$p"
            info apply "$(basename "$p")"
        else
            die "$(basename "$p") does not apply; see 'git -C qemu apply -v $p'"
        fi
    done < <(patch_list)

    while IFS= read -r rel; do
        dst="$QEMU/$rel"
        if [ -L "$dst" ]; then
            [ "$(readlink "$dst")" = "$(link_target "$rel")" ] && continue
        elif [ -e "$dst" ]; then
            die "overlay/$rel shadows an upstream file; change it with a patch"
        fi
        mkdir -p "$(dirname "$dst")"
        ln -sfn "$(link_target "$rel")" "$dst"
        info link "$rel"
    done < <(overlay_list)
}

# Symlinks in qemu/ that resolve into overlay/, including stale ones
overlay_links() {
    local link
    while IFS= read -r -d '' link; do
        case "$(realpath -m "$link")" in
        "$OVERLAY"/*) printf '%s\n' "${link#"$QEMU"/}" ;;
        esac
    done < <(find "$QEMU" -path "$QEMU/.git" -prune -o -type l -print0)
}

cmd_unapply() {
    check_tree

    local rel p
    while IFS= read -r rel; do
        rm -f "$QEMU/$rel"
        info unlink "$rel"
    done < <(overlay_links)

    while IFS= read -r p; do
        revert_recorded "$p"
    done < <(find "$APPLIED" -name '*.patch' | LC_ALL=C sort -r)

    # Trees patched before revisions were recorded
    while IFS= read -r p; do
        if is_applied "$p"; then
            qgit apply --reverse "$p"
            info revert "$(basename "$p")"
        fi
    done < <(patch_list | LC_ALL=C sort -r)
}

cmd_status() {
    check_tree

    local p rel managed file
    managed=$(mktemp)
    trap 'rm -f "$managed"' RETURN

    echo "patches:"
    local r
    while IFS= read -r p; do
        r="$APPLIED/$(basename "$p")"
        if [ -f "$r" ] && cmp -s "$r" "$p" && ! is_applied "$p"; then
            info applied "$(basename "$p") (with local edits)"
        elif [ -f "$r" ] && cmp -s "$r" "$p"; then
            info applied "$(basename "$p")"
        elif [ -f "$r" ]; then
            info outdated "$(basename "$p") (another revision is applied)"
        elif is_applied "$p"; then
            info applied "$(basename "$p") (unrecorded)"
        else
            info pending "$(basename "$p")"
        fi
        patch_files "$p" >>"$managed"
    done < <(patch_list)
    while IFS= read -r r; do
        [ -f "$PATCHES/$(basename "$r")" ] ||
            info removed "$(basename "$r") (still applied)"
    done < <(find "$APPLIED" -name '*.patch' | LC_ALL=C sort)

    echo "overlay:"
    while IFS= read -r rel; do
        if [ -L "$QEMU/$rel" ]; then
            info linked "$rel"
        else
            info missing "$rel"
        fi
        echo "$rel" >>"$managed"
    done < <(overlay_list)
    while IFS= read -r rel; do
        [ -e "$OVERLAY/$rel" ] || info stale "$rel"
    done < <(overlay_links)

    local dups
    dups=$(LC_ALL=C sort "$managed" | uniq -d)
    [ -z "$dups" ] || printf 'warning: files touched by several patches:\n%s\n' "$dups"

    echo "unmanaged changes in qemu/:"
    qgit status --porcelain | cut -c4- | while IFS= read -r file; do
        grep -qxF "$file" "$managed" || info changed "$file"
    done
}

cmd_new() {
    [ $# -ge 2 ] || die "usage: new <slug> <file>..."
    check_tree

    local slug=$1 last num out
    shift
    last=$(patch_list | tail -n1)
    last=$(basename "${last:-0000}")
    num=$(printf '%04d' $((10#${last:0:4} + 1)))
    out="$PATCHES/$num-$slug.patch"

    local msg
    msg=$(mktemp)
    trap 'rm -f "$msg"' RETURN
    printf 'subsystem: Summary in the imperative mood\n\nWhy the change is needed.\n' >"$msg"
    "${EDITOR:-vi}" "$msg"

    write_patch "$out" "$msg" "$(git -C "$ROOT" var GIT_AUTHOR_IDENT |
        sed 's/> .*/>/')" "$@"
    record "$out"
    info new "$(basename "$out")"
}

cmd_refresh() {
    [ $# -eq 1 ] || die "usage: refresh <patch>"
    local p=$1
    [ -f "$p" ] || p="$PATCHES/$1"
    [ -f "$p" ] || die "no such patch: $1"
    check_tree

    # git mailinfo splits the mail into headers (stdout), body and diff,
    # unfolding wrapped Subject lines and stripping the [PATCH] prefix.
    local tmp headers author date subject
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    headers=$(git mailinfo "$tmp/body" "$tmp/diff" <"$p")
    author="$(header Author "$headers") <$(header Email "$headers")>"
    date=$(header Date "$headers")
    subject=$(header Subject "$headers")
    { printf '%s\n\n' "$subject"; cat "$tmp/body"; } >"$tmp/msg"

    local -a files
    mapfile -t files < <(patch_files "$p")
    GIT_AUTHOR_DATE="$date" write_patch "$p" "$tmp/msg" "$author" "${files[@]}"
    record "$p"
    info refresh "$(basename "$p")"
}

# header <name> <mailinfo-output>: the value of one "Name: value" line
header() {
    sed -n "s/^$1: //p" <<<"$2"
}

# write_patch <out> <message-file> <author> <file>...: format the current
# qemu/ diff of <file>... as a single git format-patch file.
write_patch() {
    local out=$1 msg=$2 author=$3
    shift 3
    [ -n "$(qgit diff --name-only -- "$@")" ] || die "no changes in: $*"

    # Commit into a throw-away worktree so qemu/ itself is left untouched.
    # The EXIT trap also covers failures part-way through (set -e).
    local wt
    wt=$(mktemp -d)
    trap 'qgit worktree remove --force "$wt" 2>/dev/null; rm -rf "$wt"' EXIT
    qgit worktree add -q --detach "$wt" HEAD
    qgit diff --binary -- "$@" | git -C "$wt" apply --index
    git -C "$wt" -c user.name=qemu-tree -c user.email=qemu-tree@localhost \
        commit -q --author="$author" -F "$msg"
    git -C "$wt" format-patch -q -1 --no-signature --zero-commit -N \
        --stdout >"$out"
    qgit worktree remove --force "$wt"
    rm -rf "$wt"
    trap - EXIT
}

[ $# -ge 1 ] || { usage; exit 1; }
cmd=$1
shift
case "$cmd" in
apply | unapply | status | new | refresh) "cmd_$cmd" "$@" ;;
-h | --help | help) usage ;;
*) usage >&2; exit 1 ;;
esac
