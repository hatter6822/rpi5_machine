From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: A7om <hatter6822@gmail.com>
Date: Sat, 26 Sep 2026 00:00:00 +0000
Subject: [PATCH] hw/misc: Add the Broadcom RNG200 random number generator

The BCM2711 (Raspberry Pi 4) and BCM2712 (Raspberry Pi 5) both have an
RNG200. It is the "brcm,bcm2711-rng200" node, which Linux drives with
iproc-rng200.c. raspi4b disables that node today because QEMU has no
model for it. Linux's BCM2711 read path spins without a timeout until
the total bit count passes 16, so the node cannot stay enabled without
a model.

Add a model that follows the registers the driver uses. Its generator
is infinitely fast: while it runs, the 16-word FIFO stays full, and
the bit counter advances by the bits each refill takes, starting with
the warm-up bits the guest asks to discard. The data comes from
qemu_guest_getrandom_nofail(). The soft resets empty the FIFO and
restart the count. The interrupt status bits are write-one-to-clear,
and the interrupt output is their AND with the enable register.
---
 MAINTAINERS          | 2 ++
 hw/misc/Kconfig      | 3 +++
 hw/misc/meson.build  | 1 +
 hw/misc/trace-events | 4 ++++
 4 files changed, 10 insertions(+)

diff --git a/MAINTAINERS b/MAINTAINERS
index 902db77..da5355f 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -1018,8 +1018,10 @@ R: Philippe Mathieu-Daudé <philmd@mailo.com>
 L: qemu-arm@nongnu.org
 S: Odd Fixes
 F: hw/arm/raspi*.c
+F: hw/*/bcm27*
 F: hw/*/bcm283*
 F: include/hw/arm/rasp*
+F: include/hw/*/bcm27*
 F: include/hw/*/bcm283*
 F: docs/system/arm/raspi.rst
 F: tests/functional/arm/test_raspi2.py
diff --git a/hw/misc/Kconfig b/hw/misc/Kconfig
index 1d05841..9b2f207 100644
--- a/hw/misc/Kconfig
+++ b/hw/misc/Kconfig
@@ -259,6 +259,9 @@ config XLNX_ZYNQ_DDRC
 
 source macio/Kconfig
 
+config BCM2711_RNG200
+    bool
+
 config BCM2835_CPRMAN
     bool
 
diff --git a/hw/misc/meson.build b/hw/misc/meson.build
index 13b01db..f4f8cf7 100644
--- a/hw/misc/meson.build
+++ b/hw/misc/meson.build
@@ -86,6 +86,7 @@ system_ss.add(when: 'CONFIG_NPCM7XX', if_true: files(
 system_ss.add(when: 'CONFIG_OMAP', if_true: files(
   'omap_clk.c',
 ))
+system_ss.add(when: 'CONFIG_BCM2711_RNG200', if_true: files('bcm2711_rng200.c'))
 system_ss.add(when: 'CONFIG_BCM2835_CPRMAN', if_true: files('bcm2835_cprman.c'))
 system_ss.add(when: 'CONFIG_BCM2835_MBOX', if_true: files('bcm2835_mbox.c'))
 system_ss.add(when: 'CONFIG_BCM2835_MPHI', if_true: files('bcm2835_mphi.c'))
diff --git a/hw/misc/trace-events b/hw/misc/trace-events
index c9a868b..b29b0ed 100644
--- a/hw/misc/trace-events
+++ b/hw/misc/trace-events
@@ -339,6 +339,10 @@ aspeed_hace_hash_addr(const char *s, uint64_t addr) "%s: 0x%" PRIx64
 aspeed_hace_hash_execute_acc_mode(bool final_request) "final request: %d"
 aspeed_hace_hexdump(const char *desc, uint32_t offset, char *s) "%s: 0x%08x: %s"
 
+# bcm2711_rng200.c
+bcm2711_rng200_read(uint64_t offset, uint32_t value) "offset 0x%02" PRIx64 " value 0x%08" PRIx32
+bcm2711_rng200_write(uint64_t offset, uint64_t value) "offset 0x%02" PRIx64 " value 0x%08" PRIx64
+
 # bcm2835_property.c
 bcm2835_mbox_property(uint32_t tag, uint32_t bufsize, size_t resplen) "mbox property tag:0x%08x in_sz:%u out_sz:%zu"
 
