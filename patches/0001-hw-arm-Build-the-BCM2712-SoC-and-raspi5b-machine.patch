From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: A7om <hatter6822@gmail.com>
Date: Sat, 26 Sep 2026 00:00:00 +0000
Subject: [PATCH] hw/arm: Build the BCM2712 SoC and raspi5b machine

Add Kconfig symbols and meson rules for the Broadcom BCM2712 SoC model
(CONFIG_BCM2712) and the Raspberry Pi 5 Model B board (CONFIG_RASPI5).
The board is AArch64-only and, like the other Raspberry Pi boards,
requires TCG.
---
 hw/arm/Kconfig     | 13 +++++++++++++
 hw/arm/meson.build |  2 ++
 2 files changed, 15 insertions(+)

diff --git a/hw/arm/Kconfig b/hw/arm/Kconfig
index 6f5b2ad..98d52ab 100644
--- a/hw/arm/Kconfig
+++ b/hw/arm/Kconfig
@@ -368,6 +368,19 @@ config RASPI
     select BCM2835_SPI
     select BCM2835_I2C
 
+config RASPI5
+    bool
+    default y
+    depends on TCG && AARCH64
+    select BCM2712
+    select DEVICE_TREE
+
+config BCM2712
+    bool
+    select ARM_GIC
+    select PL011 # UART
+    select UNIMP
+
 config STM32F100_SOC
     bool
     select ARM_V7M
diff --git a/hw/arm/meson.build b/hw/arm/meson.build
index 4233a80..a381c31 100644
--- a/hw/arm/meson.build
+++ b/hw/arm/meson.build
@@ -32,6 +32,8 @@ arm_common_ss.add(when: 'CONFIG_RASPI', if_true: files(
   'raspi.c',
   'raspi4b.c'
 ))
+arm_common_ss.add(when: 'CONFIG_BCM2712', if_true: files('bcm2712.c'))
+arm_common_ss.add(when: 'CONFIG_RASPI5', if_true: files('raspi5b.c'))
 arm_common_ss.add(when: 'CONFIG_STM32F100_SOC', if_true: files('stm32f100_soc.c'))
 arm_common_ss.add(when: 'CONFIG_STM32F205_SOC', if_true: files('stm32f205_soc.c'))
 arm_common_ss.add(when: 'CONFIG_STM32F405_SOC', if_true: files('stm32f405_soc.c'))
