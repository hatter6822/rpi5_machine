From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: A7om <hatter6822@gmail.com>
Date: Sat, 26 Sep 2026 00:00:00 +0000
Subject: [PATCH] hw/misc/bcm2835_property: Answer the firmware and board
 identity tags

Linux's raspberrypi-firmware driver asks for the firmware variant and
hash when it probes. The model does not know either tag, so the guest
gets back a success response over whatever its buffer held.

GET_BOARD_MODEL and GET_BOARD_SERIAL were stubs that also answered
success without writing a value. GET_DMA_CHANNELS was hard-coded to
the BCM2835 answer.

Answer the variant as the standard firmware ("start") and the hash as
all zeroes, since no firmware build stands behind the model. Answer
the board model as 0. Every new answer is clipped to the guest's
buffer, and its length says how much the full value needs. Take the serial number and the DMA channel mask from
new "board-serial" and "dma-channel-mask" properties. Their defaults
keep today's DMA answer and give a zero serial, so existing boards
behave the same apart from the now defined values.
---
 hw/misc/bcm2835_property.c         | 63 ++++++++++++++++++++++++------
 include/hw/misc/bcm2835_property.h |  2 +
 2 files changed, 54 insertions(+), 11 deletions(-)

diff --git a/hw/misc/bcm2835_property.c b/hw/misc/bcm2835_property.c
index 761e365..2e412a7 100644
--- a/hw/misc/bcm2835_property.c
+++ b/hw/misc/bcm2835_property.c
@@ -21,8 +21,36 @@
 
 #define VCHI_BUSADDR_SIZE       sizeof(uint32_t)
 
+/* GET_FIRMWARE_VARIANT: the standard firmware, start*.elf */
+#define FIRMWARE_VARIANT_START  1
+
+/* GET_FIRMWARE_HASH: the git hash of the firmware build */
+#define FIRMWARE_HASH_SIZE      20
+
 /* https://github.com/raspberrypi/firmware/wiki/Mailbox-property-interface */
 
+/*
+ * Answer the tag at @value with @len bytes of @data, as much as its
+ * @bufsize-byte buffer holds; returns the response length, @len
+ */
+static size_t bcm2835_property_answer(BCM2835PropertyState *s, hwaddr value,
+                                      uint32_t bufsize, const void *data,
+                                      size_t len)
+{
+    dma_memory_write(&s->dma_as, value + 12, data, MIN(bufsize, len),
+                     MEMTXATTRS_UNSPECIFIED);
+    return len;
+}
+
+static size_t bcm2835_property_answer32(BCM2835PropertyState *s,
+                                        hwaddr value, uint32_t bufsize,
+                                        uint32_t data)
+{
+    uint32_t le = cpu_to_le32(data);
+
+    return bcm2835_property_answer(s, value, bufsize, &le, sizeof(le));
+}
+
 static void bcm2835_property_mbox_push(BCM2835PropertyState *s, uint32_t value)
 {
     uint32_t tot_len;
@@ -64,11 +92,20 @@ static void bcm2835_property_mbox_push(BCM2835PropertyState *s, uint32_t value)
             stl_le_phys(&s->dma_as, value + 12, 346337);
             resplen = 4;
             break;
+        case RPI_FWREQ_GET_FIRMWARE_VARIANT:
+            resplen = bcm2835_property_answer32(s, value, bufsize,
+                                               FIRMWARE_VARIANT_START);
+            break;
+        case RPI_FWREQ_GET_FIRMWARE_HASH:
+            /* No firmware build: an all-zero hash, clipped to the buffer */
+            resplen = FIRMWARE_HASH_SIZE;
+            address_space_set(&s->dma_as, value + 12, 0,
+                              MIN(bufsize, FIRMWARE_HASH_SIZE),
+                              MEMTXATTRS_UNSPECIFIED);
+            break;
         case RPI_FWREQ_GET_BOARD_MODEL:
-            qemu_log_mask(LOG_UNIMP,
-                          "bcm2835_property: 0x%08x get board model NYI\n",
-                          tag);
-            resplen = 4;
+            /* As current firmware: boards are told apart by revision */
+            resplen = bcm2835_property_answer32(s, value, bufsize, 0);
             break;
         case RPI_FWREQ_GET_BOARD_REVISION:
             stl_le_phys(&s->dma_as, value + 12, s->board_rev);
@@ -79,12 +116,13 @@ static void bcm2835_property_mbox_push(BCM2835PropertyState *s, uint32_t value)
             dma_memory_write(&s->dma_as, value + 12, s->macaddr.a, resplen,
                              MEMTXATTRS_UNSPECIFIED);
             break;
-        case RPI_FWREQ_GET_BOARD_SERIAL:
-            qemu_log_mask(LOG_UNIMP,
-                          "bcm2835_property: 0x%08x get board serial NYI\n",
-                          tag);
-            resplen = 8;
+        case RPI_FWREQ_GET_BOARD_SERIAL: {
+            uint64_t serial = cpu_to_le64(s->board_serial);
+
+            resplen = bcm2835_property_answer(s, value, bufsize, &serial,
+                                              sizeof(serial));
             break;
+        }
         case RPI_FWREQ_GET_ARM_MEMORY:
             /* base */
             stl_le_phys(&s->dma_as, value + 12, 0);
@@ -304,8 +342,7 @@ static void bcm2835_property_mbox_push(BCM2835PropertyState *s, uint32_t value)
             break;
 
         case RPI_FWREQ_GET_DMA_CHANNELS:
-            /* channels 2-5 */
-            stl_le_phys(&s->dma_as, value + 12, 0x003C);
+            stl_le_phys(&s->dma_as, value + 12, s->dma_channel_mask);
             resplen = 4;
             break;
 
@@ -580,6 +617,10 @@ static void bcm2835_property_realize(DeviceState *dev, Error **errp)
 static const Property bcm2835_property_props[] = {
     DEFINE_PROP_UINT32("board-rev", BCM2835PropertyState, board_rev, 0),
     DEFINE_PROP_STRING("command-line", BCM2835PropertyState, command_line),
+    DEFINE_PROP_UINT64("board-serial", BCM2835PropertyState, board_serial, 0),
+    /* The DMA channels the firmware leaves to the ARM; 2-5 by default */
+    DEFINE_PROP_UINT32("dma-channel-mask", BCM2835PropertyState,
+                       dma_channel_mask, 0x003c),
 };
 
 static void bcm2835_property_class_init(ObjectClass *klass, const void *data)
diff --git a/include/hw/misc/bcm2835_property.h b/include/hw/misc/bcm2835_property.h
index 53d2a92..2ca6ddf 100644
--- a/include/hw/misc/bcm2835_property.h
+++ b/include/hw/misc/bcm2835_property.h
@@ -31,6 +31,8 @@ struct BCM2835PropertyState {
 
     MACAddr macaddr;
     uint32_t board_rev;
+    uint64_t board_serial;
+    uint32_t dma_channel_mask;
     uint32_t addr;
     char *command_line;
     bool pending;
