From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: A7om <hatter6822@gmail.com>
Date: Sat, 26 Sep 2026 00:00:00 +0000
Subject: [PATCH] hw/misc/bcm2835_powermgt: Count the watchdog down before it
 fires

Arming the watchdog (RSTC.WRCFG = full reset) reset the machine at
once, whatever timeout WDOG held. Linux's bcm2835_wdt arms it in
bcm2835_wdt_start(), so a guest that starts the watchdog (systemd's
RuntimeWatchdogSec, for one) rebooted immediately instead of being
reset only when it stops kicking it.

Model the counter instead: WDOG[19:0] counts down in 1/65536 s ticks
while WRCFG selects the full reset, the one configuration modelled;
reads return the ticks left (as the driver's get_timeleft() expects),
writing WDOG while armed restarts it, and disarming freezes it. When it reaches zero, the partition 63 halt
pattern in RSTS still powers off, and anything else now goes through
watchdog_perform_action() so -action watchdog= applies. A reboot
through the driver's restart handler, which arms a 10 tick timeout,
is unchanged apart from the ~150us delay.

Test the halt pattern on the partition bits only: the other bits of
RSTS are status flags that need not be zero.

An armed watchdog is migrated in a subsection.
---
 hw/misc/bcm2835_powermgt.c         | 106 +++++++++++++++++++++++++----
 include/hw/misc/bcm2835_powermgt.h |   2 +
 2 files changed, 95 insertions(+), 13 deletions(-)

diff --git a/hw/misc/bcm2835_powermgt.c b/hw/misc/bcm2835_powermgt.c
index 3ec7aba..5cf5b3d 100644
--- a/hw/misc/bcm2835_powermgt.c
+++ b/hw/misc/bcm2835_powermgt.c
@@ -14,15 +14,62 @@
 #include "hw/misc/bcm2835_powermgt.h"
 #include "migration/vmstate.h"
 #include "system/runstate.h"
+#include "system/watchdog.h"
 
 #define PASSWORD 0x5a000000
 #define PASSWORD_MASK 0xff000000
 
 #define R_RSTC 0x1c
-#define V_RSTC_RESET 0x20
+#define V_RSTC_WRCFG_MASK 0x30
+#define V_RSTC_WRCFG_FULL_RESET 0x20
 #define R_RSTS 0x20
+/* The boot partition, spread over bits 0, 2, 4, 6, 8 and 10 */
+#define V_RSTS_PARTITION_MASK 0x555
 #define V_RSTS_POWEROFF 0x555 /* Linux uses partition 63 to indicate halt. */
 #define R_WDOG 0x24
+#define V_WDOG_TIME_MASK 0xfffff
+
+/* The watchdog counts down in 1/65536 s ticks. */
+#define WDOG_TICKS_PER_SEC 65536
+
+static bool bcm2835_powermgt_wdog_armed(BCM2835PowerMgtState *s)
+{
+    return (s->rstc & V_RSTC_WRCFG_MASK) == V_RSTC_WRCFG_FULL_RESET;
+}
+
+static void bcm2835_powermgt_wdog_start(BCM2835PowerMgtState *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    timer_mod(&s->watchdog, now + muldiv64(s->wdog, NANOSECONDS_PER_SECOND,
+                                           WDOG_TICKS_PER_SEC));
+}
+
+/* Ticks left before the watchdog fires, rounded up while it runs. */
+static uint32_t bcm2835_powermgt_wdog_left(BCM2835PowerMgtState *s)
+{
+    int64_t left;
+
+    if (!timer_pending(&s->watchdog)) {
+        return s->wdog;
+    }
+    left = timer_expire_time_ns(&s->watchdog) -
+           qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    return DIV_ROUND_UP(MAX(left, 0) * WDOG_TICKS_PER_SEC,
+                        NANOSECONDS_PER_SECOND);
+}
+
+static void bcm2835_powermgt_wdog_expired(void *opaque)
+{
+    BCM2835PowerMgtState *s = opaque;
+
+    s->wdog = 0;
+    if ((s->rsts & V_RSTS_PARTITION_MASK) == V_RSTS_POWEROFF) {
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+    } else {
+        watchdog_perform_action();
+    }
+}
 
 static uint64_t bcm2835_powermgt_read(void *opaque, hwaddr offset,
                                       unsigned size)
@@ -38,7 +85,7 @@ static uint64_t bcm2835_powermgt_read(void *opaque, hwaddr offset,
         res = s->rsts;
         break;
     case R_WDOG:
-        res = s->wdog;
+        res = bcm2835_powermgt_wdog_left(s);
         break;
 
     default:
@@ -56,6 +103,7 @@ static void bcm2835_powermgt_write(void *opaque, hwaddr offset,
                                    uint64_t value, unsigned size)
 {
     BCM2835PowerMgtState *s = (BCM2835PowerMgtState *)opaque;
+    bool was_armed;
 
     if ((value & PASSWORD_MASK) != PASSWORD) {
         qemu_log_mask(LOG_GUEST_ERROR,
@@ -69,24 +117,31 @@ static void bcm2835_powermgt_write(void *opaque, hwaddr offset,
 
     switch (offset) {
     case R_RSTC:
+        was_armed = bcm2835_powermgt_wdog_armed(s);
         s->rstc = value;
-        if (value & V_RSTC_RESET) {
-            if ((s->rsts & 0xfff) == V_RSTS_POWEROFF) {
-                qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
-            } else {
-                qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
-            }
+        if ((value & V_RSTC_WRCFG_MASK) != 0 &&
+            (value & V_RSTC_WRCFG_MASK) != V_RSTC_WRCFG_FULL_RESET) {
+            /* Only the full reset is used by the firmware and Linux */
+            qemu_log_mask(LOG_UNIMP,
+                          "bcm2835_powermgt_write: RSTC WRCFG 0x%"PRIx64
+                          ", only a full reset is modelled\n",
+                          value & V_RSTC_WRCFG_MASK);
+        }
+        if (bcm2835_powermgt_wdog_armed(s) && !was_armed) {
+            bcm2835_powermgt_wdog_start(s);
+        } else if (!bcm2835_powermgt_wdog_armed(s) && was_armed) {
+            s->wdog = bcm2835_powermgt_wdog_left(s);
+            timer_del(&s->watchdog);
         }
         break;
     case R_RSTS:
-        qemu_log_mask(LOG_UNIMP,
-                      "bcm2835_powermgt_write: RSTS\n");
         s->rsts = value;
         break;
     case R_WDOG:
-        qemu_log_mask(LOG_UNIMP,
-                      "bcm2835_powermgt_write: WDOG\n");
-        s->wdog = value;
+        s->wdog = value & V_WDOG_TIME_MASK;
+        if (bcm2835_powermgt_wdog_armed(s)) {
+            bcm2835_powermgt_wdog_start(s);
+        }
         break;
 
     default:
@@ -105,6 +160,24 @@ static const MemoryRegionOps bcm2835_powermgt_ops = {
     .impl.max_access_size = 4,
 };
 
+static bool bcm2835_powermgt_watchdog_needed(void *opaque)
+{
+    BCM2835PowerMgtState *s = opaque;
+
+    return timer_pending(&s->watchdog);
+}
+
+static const VMStateDescription vmstate_bcm2835_powermgt_watchdog = {
+    .name = TYPE_BCM2835_POWERMGT "/watchdog",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = bcm2835_powermgt_watchdog_needed,
+    .fields = (const VMStateField[]) {
+        VMSTATE_TIMER(watchdog, BCM2835PowerMgtState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
 static const VMStateDescription vmstate_bcm2835_powermgt = {
     .name = TYPE_BCM2835_POWERMGT,
     .version_id = 1,
@@ -114,6 +187,10 @@ static const VMStateDescription vmstate_bcm2835_powermgt = {
         VMSTATE_UINT32(rsts, BCM2835PowerMgtState),
         VMSTATE_UINT32(wdog, BCM2835PowerMgtState),
         VMSTATE_END_OF_LIST()
+    },
+    .subsections = (const VMStateDescription * const []) {
+        &vmstate_bcm2835_powermgt_watchdog,
+        NULL
     }
 };
 
@@ -124,12 +201,15 @@ static void bcm2835_powermgt_init(Object *obj)
     memory_region_init_io(&s->iomem, obj, &bcm2835_powermgt_ops, s,
                           TYPE_BCM2835_POWERMGT, 0x200);
     sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+    timer_init_ns(&s->watchdog, QEMU_CLOCK_VIRTUAL,
+                  bcm2835_powermgt_wdog_expired, s);
 }
 
 static void bcm2835_powermgt_reset(DeviceState *dev)
 {
     BCM2835PowerMgtState *s = BCM2835_POWERMGT(dev);
 
+    timer_del(&s->watchdog);
     /* https://elinux.org/BCM2835_registers#PM */
     s->rstc = 0x00000102;
     s->rsts = 0x00001000;
diff --git a/include/hw/misc/bcm2835_powermgt.h b/include/hw/misc/bcm2835_powermgt.h
index fb0740c..fa77c0d 100644
--- a/include/hw/misc/bcm2835_powermgt.h
+++ b/include/hw/misc/bcm2835_powermgt.h
@@ -12,6 +12,7 @@
 #define BCM2835_POWERMGT_H
 
 #include "hw/core/sysbus.h"
+#include "qemu/timer.h"
 #include "qom/object.h"
 
 #define TYPE_BCM2835_POWERMGT "bcm2835-powermgt"
@@ -24,6 +25,7 @@ struct BCM2835PowerMgtState {
     uint32_t rstc;
     uint32_t rsts;
     uint32_t wdog;
+    QEMUTimer watchdog;
 };
 
 #endif
