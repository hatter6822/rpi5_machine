From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: A7om <hatter6822@gmail.com>
Date: Sat, 26 Sep 2026 00:00:00 +0000
Subject: [PATCH] hw/misc/bcm2835_property: Let a subclass answer tags first

The firmware of each Raspberry Pi answers some tags with values of its
own board, such as the rates of its clocks, and a newer board's
firmware knows tags that an older one's does not. Rather than make
every answer depend on the board, let a subclass answer a tag ahead of
the device, through a new answer_tag class method, with the accessors
of the tag's value buffer that the device uses. Export the device's
migration state, for a subclass to nest in its own.

No functional change for the existing boards.
---
 hw/misc/bcm2835_property.c         | 31 +++++++++++++-----------
 include/hw/misc/bcm2835_property.h | 38 +++++++++++++++++++++++++++++-
 2 files changed, 54 insertions(+), 15 deletions(-)

diff --git a/hw/misc/bcm2835_property.c b/hw/misc/bcm2835_property.c
index c9abd9bd..70f2ff3e 100644
--- a/hw/misc/bcm2835_property.c
+++ b/hw/misc/bcm2835_property.c
@@ -33,18 +33,16 @@
  * Answer the tag at @value with @len bytes of @data, as much as its
  * @bufsize-byte buffer holds; returns the response length, @len
  */
-static size_t bcm2835_property_answer(BCM2835PropertyState *s, hwaddr value,
-                                      uint32_t bufsize, const void *data,
-                                      size_t len)
+size_t bcm2835_property_answer(BCM2835PropertyState *s, hwaddr value,
+                               uint32_t bufsize, const void *data, size_t len)
 {
     dma_memory_write(&s->dma_as, value + 12, data, MIN(bufsize, len),
                      MEMTXATTRS_UNSPECIFIED);
     return len;
 }
 
-static size_t bcm2835_property_answer32(BCM2835PropertyState *s,
-                                        hwaddr value, uint32_t bufsize,
-                                        uint32_t data)
+size_t bcm2835_property_answer32(BCM2835PropertyState *s, hwaddr value,
+                                 uint32_t bufsize, uint32_t data)
 {
     uint32_t le = cpu_to_le32(data);
 
@@ -57,8 +55,8 @@ static size_t bcm2835_property_answer32(BCM2835PropertyState *s,
  * hold is not written; the response length still says how much the whole
  * answer needs.
  */
-static uint32_t bcm2835_property_get32(BCM2835PropertyState *s, hwaddr value,
-                                       uint32_t bufsize, uint32_t offset)
+uint32_t bcm2835_property_get32(BCM2835PropertyState *s, hwaddr value,
+                                uint32_t bufsize, uint32_t offset)
 {
     if (offset + 4 > bufsize) {
         return 0;
@@ -66,9 +64,8 @@ static uint32_t bcm2835_property_get32(BCM2835PropertyState *s, hwaddr value,
     return ldl_le_phys(&s->dma_as, value + 12 + offset);
 }
 
-static void bcm2835_property_put32(BCM2835PropertyState *s, hwaddr value,
-                                   uint32_t bufsize, uint32_t offset,
-                                   uint32_t data)
+void bcm2835_property_put32(BCM2835PropertyState *s, hwaddr value,
+                            uint32_t bufsize, uint32_t offset, uint32_t data)
 {
     if (offset + 4 <= bufsize) {
         stl_le_phys(&s->dma_as, value + 12 + offset, data);
@@ -491,6 +488,7 @@ static size_t bcm2835_property_answer_tag(BCM2835PropertyState *s,
 
 static void bcm2835_property_mbox_push(BCM2835PropertyState *s, uint32_t value)
 {
+    BCM2835PropertyClass *bpc = BCM2835_PROPERTY_GET_CLASS(s);
     uint32_t tot_len;
     uint32_t bufsize = 0;
     hwaddr end, pos;
@@ -540,8 +538,12 @@ static void bcm2835_property_mbox_push(BCM2835PropertyState *s, uint32_t value)
             malformed = true;
             break;
         }
-        resplen = bcm2835_property_answer_tag(s, tag, pos, bufsize,
-                                              &fbconfig, &fbconfig_updated);
+        if (!bpc->answer_tag ||
+            !bpc->answer_tag(s, tag, pos, bufsize, &resplen)) {
+            resplen = bcm2835_property_answer_tag(s, tag, pos, bufsize,
+                                                  &fbconfig,
+                                                  &fbconfig_updated);
+        }
 
         trace_bcm2835_mbox_property(tag, bufsize, resplen);
         stl_le_phys(&s->dma_as, pos + 8,
@@ -636,7 +638,7 @@ static const MemoryRegionOps bcm2835_property_ops = {
     .valid.max_access_size = 4,
 };
 
-static const VMStateDescription vmstate_bcm2835_property = {
+const VMStateDescription vmstate_bcm2835_property = {
     .name = TYPE_BCM2835_PROPERTY,
     .version_id = 1,
     .minimum_version_id = 1,
@@ -715,6 +717,7 @@ static const TypeInfo bcm2835_property_info = {
     .name          = TYPE_BCM2835_PROPERTY,
     .parent        = TYPE_SYS_BUS_DEVICE,
     .instance_size = sizeof(BCM2835PropertyState),
+    .class_size    = sizeof(BCM2835PropertyClass),
     .class_init    = bcm2835_property_class_init,
     .instance_init = bcm2835_property_init,
 };
diff --git a/include/hw/misc/bcm2835_property.h b/include/hw/misc/bcm2835_property.h
index 2ca6ddf7..7572d85b 100644
--- a/include/hw/misc/bcm2835_property.h
+++ b/include/hw/misc/bcm2835_property.h
@@ -15,7 +15,8 @@
 #include "qom/object.h"
 
 #define TYPE_BCM2835_PROPERTY "bcm2835-property"
-OBJECT_DECLARE_SIMPLE_TYPE(BCM2835PropertyState, BCM2835_PROPERTY)
+OBJECT_DECLARE_TYPE(BCM2835PropertyState, BCM2835PropertyClass,
+                    BCM2835_PROPERTY)
 
 struct BCM2835PropertyState {
     /*< private >*/
@@ -38,4 +39,39 @@ struct BCM2835PropertyState {
     bool pending;
 };
 
+struct BCM2835PropertyClass {
+    /*< private >*/
+    SysBusDeviceClass parent_class;
+    /*< public >*/
+
+    /*
+     * For the firmware of a particular board: answer the tag @tag, whose
+     * header is at @value and whose value buffer holds @bufsize bytes,
+     * ahead of the device. Return true with the response length in
+     * *@resplen, or false to leave the tag to the device.
+     */
+    bool (*answer_tag)(BCM2835PropertyState *s, uint32_t tag, hwaddr value,
+                       uint32_t bufsize, size_t *resplen);
+};
+
+/*
+ * Accessors of the value buffer of the tag at @value, which holds
+ * @bufsize bytes: answer_tag reads its request and writes its answer
+ * with them, as the device does. A request field the buffer does not
+ * hold reads as zero, and an answer it does not hold is not written.
+ * bcm2835_property_answer() writes @len bytes of @data, or as many as
+ * the buffer holds, and returns @len, the response length.
+ */
+size_t bcm2835_property_answer(BCM2835PropertyState *s, hwaddr value,
+                               uint32_t bufsize, const void *data,
+                               size_t len);
+size_t bcm2835_property_answer32(BCM2835PropertyState *s, hwaddr value,
+                                 uint32_t bufsize, uint32_t data);
+uint32_t bcm2835_property_get32(BCM2835PropertyState *s, hwaddr value,
+                                uint32_t bufsize, uint32_t offset);
+void bcm2835_property_put32(BCM2835PropertyState *s, hwaddr value,
+                            uint32_t bufsize, uint32_t offset, uint32_t data);
+
+extern const VMStateDescription vmstate_bcm2835_property;
+
 #endif
